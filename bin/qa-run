#!/usr/bin/env node
// Public CLI: the configured service and dashboard share one durable admission slot.
import os from 'node:os';
import fs from 'node:fs';
import path from 'node:path';
import { randomUUID } from 'node:crypto';
import { readManagementConfiguration, openManagementService, readAuthenticationMode } from '../lib/management-service.mjs';
import { readManagedRevisions } from '../lib/management-revisions.mjs';
import { prepareCliArguments, parseQaArguments } from '../lib/management-cli-intent.mjs';

const argv = process.argv.slice(2);
const parsed = parseQaArguments(argv);
const option = parsed.option;
const usage = 'qa-run --repo OWNER/NAME --pr N [--dry-run | --publish] [--request-id ID] [--run-dir DIR]';
if (parsed.flag('--help')) { console.log(usage); }
else if (!(option('--repo') ?? process.env.QA_REPO) || !Number(option('--pr') ?? process.env.QA_PR)) {
  console.error(usage); process.exitCode = 2;
} else {
  let service;
  try {
    const directory = path.resolve(option('--management-dir') ?? path.join(os.homedir(), '.config', 'miu', 'management'));
    const configuration = readManagementConfiguration(directory);
    if (!configuration) {
      if (parsed.has('--management-dir') || parsed.has('--request-id')) throw new Error('management_not_configured');
      const { runQa } = await import('../lib/qa-run-worker.mjs');
      const cancellation = new AbortController();
      process.once('SIGINT', () => cancellation.abort());
      process.once('SIGTERM', () => cancellation.abort());
      const result = await runQa({ argv, signal: cancellation.signal });
      process.exitCode = result.cleanupComplete ? result.exitCode : 1;
    } else {
      if (parsed.flag('--slack')) throw new Error('unsupported_external_channel');
      const root = path.resolve(import.meta.dirname, '..');
      service = openManagementService({ directory, runsDirectory: configuration.runsDirectory,
        workerPath: path.join(root, 'bin/qa-worker'), environment: process.env,
        legacyBusy: () => fs.existsSync(path.join(root, '.cache', 'run.lock')),
        preflight: async (record) => {
          const current = await readManagedRevisions(record.intent.repo, record.intent.pr);
          return current.baseSha === record.intent.baseSha && current.headSha === record.intent.headSha;
        } });
      const requestId = option('--request-id') ?? randomUUID();
      if (!/^[A-Za-z0-9_-]{1,128}$/.test(requestId)) throw new Error('invalid_request_id');
      const repo = (option('--repo') ?? process.env.QA_REPO).toLowerCase();
      const pr = Number(option('--pr') ?? process.env.QA_PR);
      const model = option('--model') ?? 'claude-opus-5-5';
      const previous = service.store.lookup('_dashboard', requestId);
      const selected = prepareCliArguments(argv, { repo, pr, model,
        authMode: previous?.intent.authMode ?? readAuthenticationMode(configuration.runsDirectory, model) });
      const workerArgs = selected.argv;
      if (previous && (previous.intent.repo !== repo || previous.intent.pr !== pr
          || JSON.stringify(previous.intent.argv) !== JSON.stringify(workerArgs))) throw new Error('request_conflict');
      if (previous) {
        console.log(JSON.stringify({ requestId, runName: previous.runName, state: previous.state, observation: 'retained' }));
        process.exitCode = previous.state === 'succeeded' ? 0 : 1;
      } else {
        const { profileOf } = await import('../lib/project.mjs');
        if (!profileOf(repo)) throw new Error('profile_unavailable');
        const revisions = await readManagedRevisions(repo, pr);
        const requestedPath = option('--run-dir');
        if (requestedPath && path.dirname(path.resolve(requestedPath)) !== configuration.runsDirectory) throw new Error('run_directory_not_configured');
        const runName = requestedPath ? path.basename(requestedPath) : `cli-${requestId}`;
        const intent = { repo, pr, model, ...revisions, mode: selected.mode, authMode: selected.authMode,
          trust: 'trusted', policy: 'app-only', argv: workerArgs };
        const result = service.control.admitLegacy({ requestId, runName, intent, launch: service.launch });
        console.log(JSON.stringify({ requestId, runName: result.record.runName, state: result.record.state }));
        const cancel = () => { void service.control.cancel('_dashboard', requestId).catch(() => {}); };
        process.on('SIGINT', cancel); process.on('SIGTERM', cancel);
        const deadline = performance.now() + 3 * 60 * 60 * 1000;
        for (;;) {
          const record = service.store.lookup('_dashboard', requestId);
          const observed = service.control.observation('_dashboard', requestId);
          if (['succeeded', 'failed', 'cancelled'].includes(record.state)) {
            process.exitCode = record.state === 'succeeded' ? 0 : 1;
            console.log(JSON.stringify({ requestId, runName, state: record.state })); break;
          }
          if (record.state === 'unknown_effect' && !observed.live && !observed.pending) {
            process.exitCode = 1; console.log(JSON.stringify({ requestId, runName, state: 'unknown_effect' })); break;
          }
          if (performance.now() >= deadline) {
            await service.control.cancel('_dashboard', requestId);
            service.control.abandon('_dashboard', requestId);
            process.exitCode = 1;
            console.log(JSON.stringify({ requestId, runName, state: 'unknown_effect' })); break;
          }
          await new Promise((resolve) => setTimeout(resolve, 250));
        }
        process.off('SIGINT', cancel); process.off('SIGTERM', cancel);
      }
    }
  } catch (error) {
    const safe = new Set(['management_not_configured', 'invalid_request_id', 'request_conflict', 'run_directory_not_configured',
      'run_busy', 'invalid_arguments', 'engine_unavailable', 'unsupported_external_channel', 'identity_unavailable', 'repository_not_allowed', 'unsafe_configuration', 'configuration_conflict', 'store_unavailable']);
    console.error(JSON.stringify({ ok: false, code: safe.has(error?.code ?? error?.message) ? error.code ?? error.message : 'qa_start_failed' }));
    process.exitCode = 1;
  } finally { service?.close(); }
}
