#!/usr/bin/env node
// qa-run --repo owner/plugin --pr 812 [--dry-run] [--run-dir DIR]
//        [--max-turns 200] [--timeout-min 90] [--keep-env] [--skip-agent]
//
// One automated QA run for one PR:
//   1. gather   PR, diff, linked issues, the PRs it pairs with, earlier rounds
//   2. triage   which areas the diff touches; full or light run
//   3. prepare  fetch the PR and dev into persistent git worktrees (no clone, no build)
//   4. env      point the ready rexenv QA sites at the worktrees and reset them
//   5. agent    the QA agent tests and writes results.json (no tokens)
//   6. report   evidence check, verdict, comment.md and report.md
//   7. publish  screenshots, full report, PR comment, commit status
//
// --dry-run does 1 to 6 and writes the comment to disk instead of posting it.
import fs from 'node:fs';
import path from 'node:path';
import { execFileSync, spawn, spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import net from 'node:net';
import { recordRefusal, refusalIn } from '../lib/authrefused.mjs';
import { validate, computeVerdict, renderComment, renderFull, loadLedger, screenshots, forMember, openCells } from '../lib/report.mjs';
import { resolveImages, publishFullReport, previousRuns, setStatus, uploadImage, cloudinaryUrl, getLabels, setLabels, startLabels, postMember, LABELS, noteLocalImages } from '../lib/publish.mjs';
import { runAgent } from '../lib/agent.mjs';
import { engineOf, ENGINES } from '../lib/engines.mjs';
import { authFor, applyAuth, scrub, secrets, readSecret } from '../lib/connections.mjs';
import { AGENT_USER, AGENT_QASITE, shareRunDir, rmAny, agentBasePath } from '../lib/agentuser.mjs';
import { readInstruction } from '../lib/instructions.mjs';
import * as steer from '../lib/steer.mjs';
import { autoPick, lowerEffort } from '../lib/autopick.mjs';
import { withAppToken } from '../lib/ghapp.mjs';
import { notify } from '../lib/slack.mjs';
import * as gh from '../lib/github.mjs';
import { askToResolve, askToClose } from '../lib/conflict.mjs';
import { findPartners, roleOf, keyOf } from '../lib/pairs.mjs';
import { startStub } from '../lib/stub-renderer.mjs';
import { withRex } from '../lib/rexmcp.mjs';
import { fetchRef, checkoutSlot, ensureDeps, CACHE } from '../lib/worktrees.mjs';
import { ensureSites, mount, reset, setConstants, writeGuardHosts, GUARD } from '../lib/warmsites.mjs';
import { project, projectText, profileOf, roles, mainFile } from '../lib/project.mjs';

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const argv = process.argv.slice(2);
const flag = (n) => argv.includes(n);
const opt = (n, d) => { const i = argv.indexOf(n); return i > -1 ? argv[i + 1] : d; };

const repo = opt('--repo', process.env.QA_REPO);
const pr = Number(opt('--pr', process.env.QA_PR));
if (!repo || !pr) { console.error('usage: qa-run --repo OWNER/NAME --pr N [--dry-run]'); process.exit(2); }
const dryRun = flag('--dry-run');
const runDir = path.resolve(opt('--run-dir', path.join(process.env.RUNNER_TEMP ?? path.join(ROOT, 'runs'), `${repo.split('/')[1]}-${pr}-${Date.now()}`)));
const ctx = path.join(runDir, 'context');
fs.mkdirSync(ctx, { recursive: true });
// Pinned, not an alias, so a CLI update can't change the model under a run.
// --model auto:<engine> picks the model after triage (lib/autopick.mjs).
let model = opt('--model', process.env.QA_MODEL ?? 'claude-opus-5-5');
fs.writeFileSync(path.join(runDir, 'qa-run.json'), JSON.stringify({ pid: process.pid, model, repo, pr, started: new Date().toISOString() }));
const profile = profileOf(repo);
if (!profile) { console.error(`No test profile for ${repo}: add one to the profiles folder (see docs/profiles.md).`); process.exit(2); }
// The project's own notes and live hosts, appended to the agent's instructions.
const productNotes = () => {
  const hosts = project().live_hosts;
  const text = [projectText(), hosts.length ? `### Live hosts (never contact)\n\n${hosts.map((h) => `\`${h}\``).join(', ')}.` : ''].filter(Boolean).join('\n\n');
  return text ? `\n\n${text}\n` : '';
};
const runUrl = process.env.GITHUB_RUN_ID ? `${process.env.GITHUB_SERVER_URL}/${process.env.GITHUB_REPOSITORY}/actions/runs/${process.env.GITHUB_RUN_ID}` : null;

const log = (...a) => {
  const line = `[qa ${new Date().toISOString().slice(11, 19)}] ${a.join(' ')}`;
  console.log(line);
  try { fs.appendFileSync(path.join(runDir, 'run.log'), line + '\n'); } catch { /* run dir not made yet */ }
};
const sh = (cmd, args, o = {}) => execFileSync(cmd, args, { encoding: 'utf8', maxBuffer: 64 * 1024 * 1024, ...o });
const write = (f, d) => fs.writeFileSync(path.join(ctx, f), typeof d === 'string' ? d : JSON.stringify(d, null, 2));
const infra = [];

// ---------------------------------------------------------------- 1. gather
log(`gather ${repo}#${pr} into ${runDir}`);
const prData = await gh.getPr(repo, pr);
const sha = prData.headRefOid;
write('pr.json', { ...prData, comments: undefined, files: undefined });
write('diff.patch', await gh.prDiff(repo, pr));
const files = prData.files.map((f) => f.path);
write('files.txt', files.join('\n'));

fs.mkdirSync(path.join(ctx, 'issues'), { recursive: true });
const issueRefs = new Set(prData.closingIssuesReferences.map((i) => `${i.repository?.owner?.login ?? repo.split('/')[0]}/${i.repository?.name ?? repo.split('/')[1]}#${i.number}`));
for (const m of (prData.body ?? '').matchAll(/(?:([\w.-]+\/[\w.-]+))?#(\d+)/g)) {
  if (/(fixes|closes|resolves|refs?|issue)\s*:?\s*$/i.test(prData.body.slice(Math.max(0, m.index - 12), m.index))) issueRefs.add(`${m[1] ?? repo}#${m[2]}`);
}
for (const ref of issueRefs) {
  const [r, n] = ref.split('#');
  try {
    const issue = await gh.getIssue(r, n);
    write(`issues/${r.replace('/', '_')}-${n}.json`, issue);
  } catch { /* a PR number, or no access: skip */ }
}

// The pair: open PRs in the other profiled repos that belong with this
// one (lib/pairs.mjs). One run tests the whole pair: the PR side runs every PR
// of it, the dev side runs dev everywhere, and each PR gets the report.
const selfRole = roleOf(repo);
const selfKey = `${repo}#${pr}`;
let partners = {};
try { partners = await findPartners(repo, prData); } catch (e) { infra.push({ what: `Could not look for related PRs in the other repos: ${e.message.split('\n')[0]}`, blocking: false }); }
const pairList = Object.values(partners);
const partnerData = {};
if (pairList.length) {
  fs.mkdirSync(path.join(ctx, 'pair'), { recursive: true });
  for (const p of pairList) {
    const name = `${p.repo.split('/')[1]}-${p.number}`;
    try {
      const d = await gh.getPr(p.repo, p.number);
      partnerData[keyOf(p)] = d;
      write(`pair/${name}.json`, { ...d, comments: undefined });
      write(`pair/${name}.patch`, await gh.prDiff(p.repo, p.number));
    } catch (e) { infra.push({ what: `Could not read ${p.label} #${p.number}: ${e.message.split('\n')[0]}`, blocking: false }); }
  }
  log(`pair: ${pairList.map((p) => `${p.label} #${p.number} (${p.how})`).join(', ')}`);
}
write('pair.json', pairList.map(({ role, repo: r, label, number, title, headRefName, headRefOid, url, how }) => ({ role, repo: r, label, number, title, headRefName, headRefOid, url, how })));
// Older code and the dashboard still read the sibling-repo companion.
const companion = profile.sibling ? Object.values(partners).find((p) => p.repo === profile.sibling.repo) ?? null : null;
write('companion.json', companion ?? {});

// Earlier rounds, for re-tests (methodology section 5).
let prior = [];
try { prior = await previousRuns(repo, pr); } catch { /* no access in a dry run is fine */ }
const lastRound = prior.filter((p) => p.sha !== sha).sort((a, b) => b.round - a.round)[0];
const sameShaRun = prior.find((p) => p.sha === sha);
const round = sameShaRun?.round ?? (lastRound ? lastRound.round + 1 : 1);
const humanQa = prData.comments.filter((c) => /FOUND (PARTIALLY )?(NOT )?OK/.test(c.body) && !c.body.includes(`<!-- ${project().marker}`)).slice(-2);
if (prior.length || humanQa.length) {
  write('previous-rounds.md', [
    ...prior.sort((a, b) => b.round - a.round).map((p) => `## Automated round ${p.round} at ${p.sha?.slice(0, 7)}\n\n${p.body}`),
    ...humanQa.reverse().map((c) => `## Human QA comment by ${c.author.login} at ${c.createdAt}\n\n${c.body}`),
  ].join('\n\n---\n\n'));
}

// Re-test: a PR Miu already tested needs only what changed since then, plus a
// regression sweep. The base is the newest finished local run of this PR at
// another commit. "Changed" compares each file's patch in the PR then and now,
// by their added and removed lines only: a merge of dev shifts line numbers
// and context, which is not the PR's own change.
// --full (or "/miu retest full") tests everything again.
let retest = null;
const perFile = (patch) => {
  const m = new Map();
  for (const part of patch.split(/^(?=diff --git )/m)) { const f = part.match(/^diff --git a\/(\S+) b\/(\S+)/); if (f) m.set(f[2], part.split('\n').filter((l) => /^[+-]/.test(l) && !/^(\+\+\+|---) /.test(l))); }
  return m;
};
// A pair's other PRs count too: their files go in as "<repo>:<path>".
const withPartners = (m, dir) => {
  const pd = path.join(dir, 'context/pair');
  for (const f of fs.existsSync(pd) ? fs.readdirSync(pd).filter((x) => x.endsWith('.patch')) : []) {
    for (const [k, v] of perFile(fs.readFileSync(path.join(pd, f), 'utf8'))) m.set(`${f.replace(/-\d+\.patch$/, '')}:${k}`, v);
  }
  return m;
};
const pairSig = (dir) => { try { return JSON.parse(fs.readFileSync(path.join(dir, 'context/pair.json'), 'utf8')).map((x) => `${x.repo}#${x.number}@${x.headRefOid}`).sort().join(','); } catch { return ''; } };
const pairNow = pairList.map((x) => `${x.repo}#${x.number}@${x.headRefOid}`).sort().join(',');
if (!flag('--full')) {
  const runsDir = path.dirname(runDir);
  const prev = fs.readdirSync(runsDir).map((d) => path.join(runsDir, d)).filter((d) => d !== runDir).map((d) => {
    try {
      const p = JSON.parse(fs.readFileSync(path.join(d, 'context/pr.json'), 'utf8'));
      const v = JSON.parse(fs.readFileSync(path.join(d, 'verdict.json'), 'utf8'));
      // The same commit counts only when a PR of the pair moved since.
      if (p.url !== prData.url || (p.headRefOid === sha && pairSig(d) === pairNow) || v.verdict === 'inconclusive' || v.verdict === 'no_result' || !fs.existsSync(path.join(d, 'results.json'))) return null;
      return { dir: d, sha: p.headRefOid, round: v.round ?? 1, at: fs.statSync(path.join(d, 'verdict.json')).mtimeMs };
    } catch { return null; }
  }).filter(Boolean).sort((a, b) => b.at - a.at)[0];
  if (prev) {
    const then = withPartners(perFile(fs.readFileSync(path.join(prev.dir, 'context/diff.patch'), 'utf8')), prev.dir);
    const now = withPartners(perFile(fs.readFileSync(path.join(ctx, 'diff.patch'), 'utf8')), runDir);
    const same = (a = [], b = []) => a.length === b.length && a.every((l, k) => l === b[k]);
    const changedFiles = [...new Set([...then.keys(), ...now.keys()])].filter((f) => !same(then.get(f), now.get(f)));
    const delta = (f) => { const a = then.get(f) ?? [], b = now.get(f) ?? [], A = new Set(a), B = new Set(b); return b.filter((l) => !A.has(l)).length + a.filter((l) => !B.has(l)).length; };
    const old = JSON.parse(fs.readFileSync(path.join(prev.dir, 'results.json'), 'utf8'));
    // The earlier evidence comes along as ev-pNNN, so carried results cite it.
    const ev = path.join(runDir, 'evidence');
    fs.mkdirSync(ev, { recursive: true });
    const remap = new Map();
    const oldShots = (() => { try { return JSON.parse(fs.readFileSync(path.join(prev.dir, 'screenshots.json'), 'utf8')); } catch { return {}; } })();
    const carriedShots = {};
    for (const line of fs.readFileSync(path.join(prev.dir, 'evidence/index.jsonl'), 'utf8').split('\n').filter(Boolean)) {
      const row = JSON.parse(line);
      const id = row.id.replace(/^ev-/, 'ev-p');
      const file = `p-${row.file}`;
      try { fs.copyFileSync(path.join(prev.dir, 'evidence', row.file), path.join(ev, file)); } catch { continue; }
      if (oldShots[row.file]) carriedShots[file] = oldShots[row.file];
      remap.set(row.id, id);
      fs.appendFileSync(path.join(ev, 'index.jsonl'), JSON.stringify({ ...row, id, file, label: `round ${prev.round}: ${row.label}`, carried_from: { round: prev.round, sha: prev.sha } }) + '\n');
    }
    if (Object.keys(carriedShots).length) fs.writeFileSync(path.join(runDir, 'screenshots.carried.json'), JSON.stringify(carriedShots, null, 2));
    const ids = (a) => (a ?? []).map((x) => remap.get(x)).filter(Boolean);
    retest = {
      round: prev.round, sha: prev.sha, run: path.basename(prev.dir),
      changed_files: changedFiles,
      unchanged_files: [...now.keys()].filter((f) => !changedFiles.includes(f)),
      changed_patch_lines: changedFiles.reduce((n, f) => n + delta(f), 0),
      changed_by_file: Object.fromEntries(changedFiles.map((f) => [f, delta(f)])),
      criteria: (old.criteria ?? []).map((c) => ({ id: c.id, claim: c.claim, visible: c.visible, baseline: c.baseline && { ...c.baseline, evidence: ids(c.baseline.evidence) }, results: Object.fromEntries(Object.entries(c.results ?? {}).map(([k, v]) => [k, { ...v, evidence: ids(v.evidence) }])) })),
      issues: (old.issues ?? []).map((i) => ({ severity: i.severity, title: i.title, evidence: ids(i.evidence) })),
      environments: old.environments,
    };
    write('retest.json', retest);
    log(`retest: round ${prev.round} at ${prev.sha.slice(0, 7)}, ${changedFiles.length} file(s) changed in the PR since then, ${remap.size} evidence item(s) carried`);
  }
}

// No Miu round to compare with, but a person reported on this PR: compare
// with the commit that person tested. The PR's head at the time of their
// report comes from its commits and force pushes. What changed in the PR's
// own lines since then is re-tested, with what they found failing and a
// regression sweep; the rest is listed as unchanged since their round (no
// evidence of theirs to carry, so nothing unchanged is claimed as a pass).
if (!retest && !flag('--full') && humanQa.length) {
  const human = humanQa.at(-1);
  try {
    const T = Date.parse(human.createdAt);
    const [owner, name] = repo.split('/');
    const h = (await gh.graphql(`query($owner: String!, $name: String!, $n: Int!) { repository(owner: $owner, name: $name) { pullRequest(number: $n) {
      commits(last: 100) { nodes { commit { oid committedDate } } }
      timelineItems(last: 50, itemTypes: [HEAD_REF_FORCE_PUSHED_EVENT]) { nodes { ... on HeadRefForcePushedEvent { createdAt afterCommit { oid } } } } } } }`, { owner, name, n: pr })).repository.pullRequest;
    const candidates = [
      ...h.commits.nodes.map((c) => ({ oid: c.commit.oid, at: Date.parse(c.commit.committedDate) })),
      ...h.timelineItems.nodes.filter((e) => e.afterCommit).map((e) => ({ oid: e.afterCommit.oid, at: Date.parse(e.createdAt) })),
    ].filter((c) => c.at <= T).sort((a, b) => b.at - a.at);
    const then = candidates[0];
    if (then && then.oid !== prData.headRefOid) {
      const auth = await gh.gitAuthEnv(repo);
      const bare = path.join(CACHE, 'repos', `${repo.split('/')[1]}.git`);
      const base = fetchRef(repo, prData.baseRefName, auth);
      const head = fetchRef(repo, `refs/pull/${pr}/head`, auth);
      // The tested commit, by sha (still in the PR's history unless rebased away).
      execFileSync('git', ['-C', bare, 'fetch', '--quiet', 'https://github.com/' + repo + '.git', then.oid], { env: { ...process.env, ...auth }, stdio: 'ignore' });
      const g = (args) => execFileSync('git', ['-C', bare, ...args], { encoding: 'utf8', maxBuffer: 256 * 1024 * 1024 });
      const patchOf = (tip) => g(['diff', g(['merge-base', base, tip]).trim(), tip]);
      const a = perFile(patchOf(then.oid)), b = perFile(patchOf(head));
      const same = (x = [], y = []) => x.length === y.length && x.every((l, k) => l === y[k]);
      const changedFiles = [...new Set([...a.keys(), ...b.keys()])].filter((f) => !same(a.get(f), b.get(f)));
      const delta = (f) => { const x = a.get(f) ?? [], y = b.get(f) ?? [], X = new Set(x), Y = new Set(y); return y.filter((l) => !X.has(l)).length + x.filter((l) => !Y.has(l)).length; };
      retest = {
        kind: 'person', by: human.author?.login ?? 'a person', at: human.createdAt, verdict: verdictOfComment(human.body), sha: then.oid,
        report: human.body.slice(0, 8000),
        changed_files: changedFiles, changed_by_file: Object.fromEntries(changedFiles.map((f) => [f, delta(f)])),
        changed_patch_lines: changedFiles.reduce((n, f) => n + delta(f), 0),
        criteria: [], issues: [],
      };
      write('retest.json', retest);
      log(`retest: since ${retest.by}'s report at ${then.oid.slice(0, 7)}, ${changedFiles.length} file(s), ${retest.changed_patch_lines} line(s) of the PR changed since`);
    }
  } catch (e) { log(`retest from the person's report skipped: ${String(e.message).split('\n')[0]}`); }
}

// ---------------------------------------------------------------- 2. triage
const touches = (re) => files.some((f) => new RegExp(re).test(f));
const areas = Object.fromEntries(Object.entries(profile.triage).map(([k, re]) => [k, k === 'docs_only' ? files.every((f) => new RegExp(re).test(f)) : touches(re)]));
const mode = areas.docs_only ? 'light' : 'full';
// How deep to go, by the size of the change. Sets the agent's turn budget and
// tells it how much to test, so a one-line fix doesn't get a 40-minute run.
const changed = prData.files.reduce((a, f) => a + (f.additions ?? 0) + (f.deletions ?? 0), 0);
// A re-test is sized by what changed since the last round, not the whole PR.
// Docs, unit tests and built bundles need no runtime testing, so they do not
// make a run deeper.
// A pair is sized by all of its PRs.
const RUNTIME = (f) => !/^(docs|tests?|assets)\/|\.md$|(^|\/)(composer|package)(-lock)?\.json$/.test(f.replace(/^[\w.-]+:/, ''));
const allFiles = [...prData.files, ...Object.values(partnerData).flatMap((d) => d.files)];
const sized = retest
  ? { files: retest.changed_files.filter(RUNTIME).length, lines: retest.changed_files.filter(RUNTIME).reduce((n, f) => n + (retest.changed_by_file?.[f] ?? 0), 0) }
  : { files: allFiles.filter((f) => RUNTIME(f.path)).length, lines: allFiles.filter((f) => RUNTIME(f.path)).reduce((n, f) => n + (f.additions ?? 0) + (f.deletions ?? 0), 0) };
const depth = mode === 'light' ? 'quick'
  : retest && sized.files === 0 ? 'quick'
  : (sized.files <= 4 && sized.lines <= 80) ? 'quick'
  : (sized.files <= 15 && sized.lines <= 600) ? 'standard' : 'deep';
const DEPTH = {
  quick: { turns: 60, minutes: 15, what: 'Test each claim once in the one combo that matters, plus a boot check of the others. A short regression sweep.' },
  standard: { turns: 150, minutes: 35, what: 'Every claim in each combo it touches, the baseline repro for bug fixes, and the edge cases the diff makes risky.' },
  deep: { turns: 250, minutes: 70, what: 'The full method: every claim in every combo, baseline repro, edge cases and a wide regression sweep.' },
};
// Auto model and effort, from this PR's depth and areas (lib/autopick.mjs).
let autoEffort = null, autoWhy = null;
if (model.startsWith('auto') || opt('--effort', '') === 'auto') {
  const engineForAuto = model.startsWith('auto') ? (model.split(':')[1] || 'claude') : engineOf(model);
  const p = autoPick({ engine: engineForAuto, depth, areas });
  const was = model;
  if (model.startsWith('auto')) model = p.model;
  if (opt('--effort', '') === 'auto') autoEffort = p.effort;
  autoWhy = p.why;
  log(`auto: ${was.startsWith('auto') ? `model ${model}` : `model ${model} (fixed)`}, effort ${autoEffort ?? 'fixed'}, for a ${p.why}`);
  try { fs.writeFileSync(path.join(runDir, 'qa-run.json'), JSON.stringify({ ...JSON.parse(fs.readFileSync(path.join(runDir, 'qa-run.json'), 'utf8')), model })); } catch { /* the dashboard reads models.jsonl too */ }
}
function verdictOfComment(body = '') {
  const head = body.split('\n').slice(0, 6).join('\n');
  return /FOUND\s+NOT\s+OK/i.test(head) ? 'not_ok' : /FOUND\s+PARTIALLY\s+OK/i.test(head) ? 'partial' : /FOUND\s+OK/i.test(head) ? 'ok' : null;
}
const triage = { mode, depth, changed_lines: changed, areas, round, files: files.length, retest: retest ? { kind: retest.kind ?? 'miu', by: retest.by, round: retest.round, sha: retest.sha, changed_files: retest.changed_files } : null, companion: companion ? `${companion.repo}#${companion.number}` : null, pair: pairList.map((p) => `${p.label} #${p.number}`) };
write('triage.json', triage);
// --plan: work out the scope (re-test, depth) and stop, for checking.
if (flag('--plan')) { log(`plan: depth ${depth}${retest ? `, re-test since ${retest.kind === 'person' ? retest.by + "'s report" : 'round ' + retest.round} at ${retest.sha.slice(0, 7)}` : ', full test'}`); process.exit(0); }
// The results.json example is read only at the end (prompt phase 7).
// Instructions as edited in Settings → Instructions, or the defaults (lib/instructions.mjs).
const instr = (id) => readInstruction(id, path.dirname(runDir));
fs.writeFileSync(path.join(ctx, 'results-example.md'), instr('results-example'));
log('triage', JSON.stringify(triage));

// Two checks before any testing, both from a trial merge in the bare clone
// (nothing is pushed, no tokens are spent):
// - merge conflicts: what would be merged is not known until the author
//   resolves them, and testing now means testing twice. Miu asks the author
//   once per commit and tests again when a new commit lands.
// - already in the base branch: the merge changes nothing, because every line
//   of the PR is already there (another PR landed the same fix). Miu asks the
//   author to check and close it instead of testing code that is already in.
// --force tests anyway. The same trial merge gives the agent the base-branch
// history since the PR branched off, to tell "already fixed by #NNN".
{
  let mergeable = prData.mergeable;
  for (let i = 0; mergeable === 'UNKNOWN' && i < 3; i++) {
    spawnSync('sleep', ['3']);
    mergeable = await gh.prMergeable(repo, pr);
  }
  let trial = null;
  try {
    const auth = await gh.gitAuthEnv(repo);
    const base = fetchRef(repo, prData.baseRefName, auth);
    const head = fetchRef(repo, `refs/pull/${pr}/head`, auth);
    const bare = path.join(CACHE, 'repos', `${repo.split('/')[1]}.git`);
    const g = (args) => spawnSync('git', ['-C', bare, ...args], { encoding: 'utf8', maxBuffer: 16 * 1024 * 1024 });
    const mt = g(['merge-tree', '--write-tree', '--name-only', '--no-messages', base, head]);
    const lines = mt.stdout.split('\n').filter(Boolean);
    const mergeBase = g(['merge-base', base, head]).stdout.trim();
    trial = {
      base, head, mergeBase,
      clean: mt.status === 0,
      conflicts: mt.status === 0 ? [] : lines.slice(1),
      noChange: mt.status === 0 && lines[0] === g(['rev-parse', `${base}^{tree}`]).stdout.trim(),
    };
    // What landed on the base branch since the PR branched off, in the PR's files.
    if (mergeBase) {
      const hist = g(['log', '--format=%h %ad %s', '--date=short', '-n', '40', `${mergeBase}..${base}`, '--', ...files]).stdout.trim();
      write('base-history.md', `# ${prData.baseRefName} since this PR branched off (${mergeBase.slice(0, 7)}), commits touching the PR's files\n\n${hist ? hist.split('\n').map((l) => `- ${l}`).join('\n') : '_none_'}\n`);
    }
  } catch (e) { log(`trial merge skipped: ${e.message.split('\n')[0]}`); }
  if (!flag('--force') && (mergeable === 'CONFLICTING' || trial?.conflicts.length)) {
    const conflicts = trial?.conflicts ?? [];
    log(`conflict: ${repo}#${pr} cannot merge into ${prData.baseRefName}${conflicts.length ? ` (${conflicts.length} file(s): ${conflicts.slice(0, 5).join(', ')})` : ''}; not testing`);
    fs.writeFileSync(path.join(runDir, 'conflict.json'), JSON.stringify({ kind: 'conflict', sha, base: prData.baseRefName, files: conflicts, at: new Date().toISOString() }, null, 2));
    if (!dryRun) await withAppToken(() => askToResolve({ repo, pr, sha, author: prData.author?.login, base: prData.baseRefName, files: conflicts, log }), log);
    process.exit(0);
  }
  if (!flag('--force') && trial?.noChange) {
    log(`already in ${prData.baseRefName}: merging ${repo}#${pr} changes nothing; not testing`);
    fs.writeFileSync(path.join(runDir, 'conflict.json'), JSON.stringify({ kind: 'already_in_base', sha, base: prData.baseRefName, files: [], at: new Date().toISOString() }, null, 2));
    if (!dryRun) await withAppToken(() => askToClose({ repo, pr, sha, author: prData.author?.login, base: prData.baseRefName, log }), log);
    process.exit(0);
  }
}

// Every PR the run reports on: this one, then the rest of the pair.
const members = [
  { key: selfKey, repo, pr, sha, label: profile.label, round },
  ...await Promise.all(pairList.map(async (p) => {
    let r = 1;
    try { const old = await previousRuns(p.repo, p.number); const same = old.find((o) => o.sha === p.headRefOid); r = same?.round ?? (old.length ? Math.max(...old.map((o) => o.round)) + 1 : 1); } catch { /* none */ }
    return { key: keyOf(p), repo: p.repo, pr: p.number, sha: p.headRefOid, label: p.label, round: r };
  })),
];
// Labels each PR had before, so an inconclusive or stopped run can put them back.
const labelsBefore = {};
if (!dryRun) await withAppToken(async (asApp) => {
  log(`github: writing as ${asApp ? 'the Miu App' : 'the local gh login'}`);
  for (const m of members) {
    try { await setStatus({ repo: m.repo, sha: m.sha, verdict: 'pending', url: runUrl }); } catch (e) { log(`status not set on ${m.key}:`, e.message.split('\n')[0]); }
    try {
      labelsBefore[m.key] = await getLabels(m.repo, m.pr);
      const now = await setLabels(m.repo, m.pr, startLabels());
      log(`labels ${m.key}: ${now.join(', ') || 'none'}`);
    } catch (e) { log(`labels not changed on ${m.key}:`, e.message.split('\n')[0]); }
  }
  // The first entry keeps the old shape the dashboard's stop button reads.
  fs.writeFileSync(path.join(runDir, 'labels-before.json'), JSON.stringify({ repo, pr, labels: labelsBefore[selfKey] ?? [], members: members.map((m) => ({ repo: m.repo, pr: m.pr, labels: labelsBefore[m.key] ?? [] })) }));
}, log);

// ---------------------------------------------------------------- 3. prepare
// Code comes from git worktrees that persist between runs (lib/worktrees.mjs):
// a fetch and a checkout, no clone, no build. Both plugins commit their built
// assets, so the worktree is what the pull request ships.
// Git reads for every repo of the org go through the same App token (or the
// fallback), carried in the environment of each git call.
const gitAuth = await gh.gitAuthEnv(repo);
// Merged over the shell's environment, so a person's own Composer login (a Mac) still wins where it is set.
const depsEnv = { ...(await gh.composerAuthEnv(repo).catch(() => ({}))), ...process.env };
// For a repo or package the Miu App is not installed on: the person's token
// (lib/github.mjs), tried only after the App's token fails.
const gitFallback = await gh.gitAuthEnv(repo, { fallback: true }).catch(() => null);
const depsFallback = await gh.composerAuthEnv(repo, { fallback: true }).catch(() => null);

// Worktrees are shared by every run, so only one run may use them at a time.
const lockFile = path.join(CACHE, 'run.lock');
fs.mkdirSync(CACHE, { recursive: true });
const holder = fs.existsSync(lockFile) ? Number(fs.readFileSync(lockFile, 'utf8')) : 0;
const alive = (pid) => { try { process.kill(pid, 0); return true; } catch { return false; } };
if (holder && holder !== process.pid && alive(holder)) { console.error(`Another QA run (pid ${holder}) is using the worktrees.`); process.exit(3); }
fs.writeFileSync(lockFile, String(process.pid));
process.on('exit', () => { try { if (Number(fs.readFileSync(lockFile, 'utf8')) === process.pid) fs.rmSync(lockFile); } catch { /* gone */ } });

const builds = [];
const slotInfo = {};
fs.mkdirSync(path.join(ctx, 'builds'), { recursive: true });
fs.mkdirSync(path.join(runDir, 'src'), { recursive: true });
function useSlot(label, r, ref, slotName) {
  const t0 = Date.now();
  try {
    const sha = fetchRef(r, ref, gitAuth, gitFallback);
    const dir = checkoutSlot(r, slotName, sha);
    const did = ensureDeps(dir, { env: depsEnv, fallbackEnv: depsFallback });
    const mf = mainFile(profileOf(r));
    const main = mf && fs.readdirSync(dir).find((f) => f === mf);
    const version = main ? (fs.readFileSync(path.join(dir, main), 'utf8').match(/Version:\s*(\S+)/) ?? [])[1] ?? null : null;
    write(`builds/${label}.json`, { label, ok: true, repo: r, ref, sha, version, dir, deps: did });
    slotInfo[label] = { repo: r, sha };
    builds.push({ label, ok: true });
    const link = path.join(runDir, 'src', label);
    fs.rmSync(link, { force: true });
    fs.symlinkSync(dir, link);
    log(`checkout ${label}: ${sha.slice(0, 7)}${version ? ` v${version}` : ''}${did.length ? ` (${did.join(', ')})` : ''} in ${((Date.now() - t0) / 1000).toFixed(1)}s`);
    return dir;
  } catch (e) {
    // The line that says what went wrong, not a tool's usage text.
    const lines = String(e.stderr || e.message).split('\n').map((l) => l.trim()).filter(Boolean);
    const msg = (lines.find((l) => /could not|failed to|error:|not found|denied|\b40[134]\b|unable to/i.test(l) && !/^\[|^install \[/.test(l)) ?? lines[0] ?? 'unknown error').slice(0, 300).replace(/AUTHORIZATION: basic \S+/gi, 'AUTHORIZATION: ***');
    write(`builds/${label}.json`, { label, ok: false, repo: r, ref, error: msg });
    builds.push({ label, ok: false });
    infra.push({ what: `Could not prepare ${label} (${r} ${ref}): ${msg}`, impact: `no ${label} code`, blocking: true });
    log(`checkout ${label}: FAILED ${msg}`);
    return null;
  }
}

const srcs = {};
const prRef = `refs/pull/${pr}/head`;
// What each side runs. The PR side: this PR, and the pair's other PRs in their
// repos. The dev side: dev of every repo the run needs. A pair with a Hub PR
// starts the Hubs; a pair with a plugin PR starts the QA sites.
const ROLES = roles();
const REPO_OF = Object.fromEntries(Object.entries(ROLES).map(([k, v]) => [k, v.repo]));
// The app's env script (up, logs, down): its profile's `env`.
const APP_ENV = path.resolve(ROOT, profileOf(REPO_OF.hub)?.env ?? 'env/hub/env.sh');
const prRefFor = (role) => (role === selfRole ? prRef : partners[role] ? `refs/pull/${partners[role].number}/head` : null);
const needWp = profile.kind === 'wp-plugin' || !!(partners.free || partners.pro);
const needHub = profile.kind === 'hub' || !!partners.hub;
for (const role of [...(needWp ? ['free', 'pro'] : []), ...(needHub ? ['hub'] : [])].filter((r) => REPO_OF[r])) {
  const own = role === selfRole;
  if (!own && mode !== 'full') continue;
  if (prRefFor(role)) srcs[`${role}-pr`] = useSlot(`${role}-pr`, REPO_OF[role], prRefFor(role), 'pr');
  if (mode === 'full') srcs[`${role}-dev`] = useSlot(`${role}-dev`, REPO_OF[role], profile.base_branch, 'dev');
}
srcs.pr = srcs[`${selfRole}-pr`];
// A UI source change without a rebuilt bundle runs the old UI on every site,
// for a repo that commits its build (the profile's `built_ui`).
const bu = profile.built_ui;
const uiBuildStale = !!bu && files.some((f) => new RegExp(bu.source).test(f)) && !files.some((f) => new RegExp(bu.built).test(f));
if (uiBuildStale) { triage.ui_build_stale = true; write('triage.json', triage); log('triage: the UI source changed but its built files did not'); }

// ---------------------------------------------------------------- 4. env
// Two QA sites stay up in rexenv (lib/warmsites.mjs). The run points their
// plugin folders at the worktrees and resets them to a clean snapshot, which
// takes about a second. Scratch sites the agent makes for special cases are
// deleted at the end; sites that existed before the run are never touched.
// No host: binds every interface, so a server listening on :: counts as taken.
const freePort = (start) => new Promise((resolve) => {
  const tryPort = (p) => { const srv = net.createServer().once('error', () => tryPort(p + 1)).once('listening', () => srv.close(() => resolve(p))).listen(p); };
  tryPort(start);
});
// Hub runs, and pairs with a Hub PR, get two Hubs, like the two QA sites:
// pr (after) and dev (before). Both send renders to a stub renderer whose
// answers the agent scripts (lib/stub-renderer.mjs).
const hubPorts = {};
let stub = null;
if (needHub && mode === 'full') {
  hubPorts.QA_HUB_PORT_PR = String(await freePort(18787));
  hubPorts.QA_HUB_PORT_DEV = String(await freePort(Number(hubPorts.QA_HUB_PORT_PR) + 1));
  hubPorts.QA_HUB_APP_PORT_PR = String(await freePort(15173));
  hubPorts.QA_HUB_APP_PORT_DEV = String(await freePort(Number(hubPorts.QA_HUB_APP_PORT_PR) + 1));
  try {
    stub = await startStub(runDir, await freePort(18900));
    hubPorts.QA_STUB_RENDERER_URL = stub.url;
    log(`stub renderer: ${stub.url}`);
  } catch (e) { infra.push({ what: `The stub renderer did not start: ${e.message}`, impact: 'renders cannot be tested', blocking: false }); }
}
process.on('exit', () => stub?.close());
// Where the plugin finds each Hub: the app URL, which serves the dashboard and
// passes /api to the server the way the live app does.
const hubUrl = (which) => {
  const dir = srcs[`hub-${which}`];
  return dir && fs.existsSync(path.join(dir, 'app/vite.config.ts')) ? `http://localhost:${hubPorts[`QA_HUB_APP_PORT_${which.toUpperCase()}`]}` : `http://localhost:${hubPorts[`QA_HUB_PORT_${which.toUpperCase()}`]}`;
};
const envVars = { ...process.env, QA_RUN_DIR: runDir, QA_CACHE_DIR: CACHE, ...hubPorts, QA_EVIDENCE_DIR: path.join(runDir, 'evidence') };
let rexBefore = new Set();
let qaSites = null;
const rexSites = (r) => (Array.isArray(r) ? r : (r?.sites ?? [])).map((x) => ({ id: x.id, domain: x.domain }));
if (mode === 'full') {
  try {
    await withRex(async (rex) => {
      const st = await rex.call('stack_status');
      const down = st.services.filter((x) => !x.optional && !x.running).map((x) => x.name);
      if (down.length) throw new Error(`rexenv services not running: ${down.join(', ')}`);
      rexBefore = new Set(rexSites(await rex.call('list_sites')).map((x) => x.id));
    });
    // Redis for object-cache work; rexenv starts it on 127.0.0.1:16379.
    const redis = spawnSync('rex', ['service', 'start', 'redis'], { encoding: 'utf8', timeout: 60000 });
    log(`rexenv: stack up${redis.status === 0 ? ', redis on 16379' : ', redis did not start'}`);
    if (needWp) {
      const t0 = Date.now();
      qaSites = await ensureSites(log);
      const runs = {
        pr: Object.fromEntries(['free', 'pro'].filter((r) => ROLES[r]).map((r) => [ROLES[r].slug, srcs[`${r}-pr`] ?? srcs[`${r}-dev`]])),
        dev: Object.fromEntries(['free', 'pro'].filter((r) => ROLES[r]).map((r) => [ROLES[r].slug, srcs[`${r}-dev`]])),
      };
      mount('pr', runs.pr);
      mount('dev', runs.dev);
      await reset('pr');
      await reset('dev');
      // A pair with an app PR: each site talks to its own side's app, through
      // the constants the app's profile names (`plugin_constants`). Otherwise
      // they come off, so the site stays on the guarded default.
      const pc = profileOf(REPO_OF.hub)?.plugin_constants;
      if (pc?.url) for (const w of ['pr', 'dev']) {
        const on = needHub && hubPorts.QA_HUB_PORT_PR;
        await setConstants(w, { [pc.url]: on ? hubUrl(w) : null, ...(pc.allow_http ? { [pc.allow_http]: on ? true : null } : {}) });
      }
      // Slot folders are <repo>-<slot>; the longer repo name first ("plugin-pro" starts with "plugin").
      const names = Object.entries(REPO_OF).map(([k, v]) => [k, v.split('/')[1]]).sort((x, y) => y[1].length - x[1].length);
      const label = (dir) => { if (!dir) return 'none'; const b = path.basename(dir); const hit = names.find(([, n]) => b.startsWith(`${n}-`)); return hit ? `${hit[0]}-${b.slice(hit[1].length + 1)}` : b; };
      for (const w of ['pr', 'dev']) {
        qaSites[w].runs = Object.fromEntries(Object.entries(runs[w]).map(([k, v]) => [k, label(v)]));
        if (needHub) qaSites[w].hub = hubUrl(w);
      }
      write('sites.json', qaSites);
      log(`rexenv: sites ready in ${((Date.now() - t0) / 1000).toFixed(1)}s, qa-pr.rex runs ${Object.values(qaSites.pr.runs).join(' + ')}, qa-dev.rex runs ${Object.values(qaSites.dev.runs).join(' + ')}`);
    }
  } catch (e) {
    infra.push({ what: `rexenv is not ready: ${e.message}`, impact: 'no test site', blocking: true });
    log(`rexenv env: FAILED ${e.message}`);
  }
  if (needHub) {
    // Both Hubs start side by side; each build is cached per commit.
    const t0 = Date.now();
    const up = (which) => new Promise((resolve) => {
      if (!srcs[`hub-${which}`]) return resolve({ which, ok: false, out: `no hub-${which} checkout` });
      const child = spawn(APP_ENV, ['up', srcs[`hub-${which}`], which], { env: { ...envVars, PATH: `${path.dirname(process.execPath)}:${envVars.PATH}` } });
      let out = '';
      child.stdout.on('data', (d) => { out += d; }); child.stderr.on('data', (d) => { out += d; });
      const timer = setTimeout(() => child.kill('SIGTERM'), 15 * 60 * 1000);
      child.on('close', (code) => { clearTimeout(timer); resolve({ which, ok: code === 0, out }); });
    });
    const hubs = {};
    for (const r of await Promise.all(['pr', 'dev'].map(up))) {
      fs.writeFileSync(path.join(runDir, `hub-up-${r.which}.log`), r.out);
      if (r.ok) hubs[r.which] = JSON.parse(fs.readFileSync(path.join(runDir, 'hub', r.which, 'info.json'), 'utf8'));
      else infra.push({ what: `The ${r.which} Hub did not start (see hub-up-${r.which}.log)`, impact: r.which === 'pr' ? 'runtime criteria cannot be tested' : 'claims cannot be reproduced on dev', blocking: true });
      log(`hub env: ${r.which} ${r.ok ? `up, ${r.out.trim().split('\n').pop()}` : 'FAILED'}`);
    }
    write('hubs.json', hubs);
    log(`hub env: ready in ${((Date.now() - t0) / 1000).toFixed(1)}s`);
  }
}
async function rexCleanup() {
  try {
    await withRex(async (rex) => {
      for (const site of rexSites(await rex.call('list_sites'))) {
        if (rexBefore.has(site.id) || !/\.scratch\./.test(site.domain)) continue;
        try { await rex.call('scratch_delete_site', { site_id: site.id }); log(`rexenv: deleted ${site.domain}`); } catch (e) { log(`rexenv: could not delete ${site.domain}: ${e.message}`); }
      }
    });
  } catch (e) { log(`rexenv cleanup skipped: ${e.message}`); }
}

// The repo's own suites on the PR head, run alongside the agent instead of
// before it (they can take ten minutes). fast-checks.md is rewritten as each
// one finishes, so the agent reads it when it gets to it. A failure is re-run
// on dev so the agent can tell a new failure from one dev already has.
// The checks build and write files, so they run in a third worktree per repo
// (<repo>-check), never in the worktrees the QA sites are serving.
const prLabel = `${selfRole}-pr`;
const devLabel = prLabel.replace('-pr', '-dev');
const checkSlot = (label) => {
  const info = slotInfo[label];
  if (!info) return null;
  const dir = checkoutSlot(info.repo, 'check', info.sha);
  ensureDeps(dir, { env: depsEnv, fallbackEnv: depsFallback });
  return dir;
};
let prSrc = null;
let devSrc = null;
const fastLines = new Map((profile.fast_checks ?? []).map((c) => [c.label, `- ${c.label}: waiting`]));
const writeFast = (done) => write('fast-checks.md', ['# Fast checks on the PR head', '', done ? '' : '_Still running; read this file again later._', '', ...fastLines.values()].join('\n'));
const runCmd = (cmd, dir) => new Promise((resolve) => {
  const child = spawn('bash', ['-c', cmd], { cwd: dir, env: { ...envVars, PATH: `${path.dirname(process.execPath)}:${envVars.PATH}`, XSPEED_DIR: srcs['free-pr'] ?? srcs['free-dev'] ?? '' } });
  let out = '';
  child.stdout.on('data', (d) => { out += d; }); child.stderr.on('data', (d) => { out += d; });
  const timer = setTimeout(() => child.kill('SIGTERM'), 20 * 60 * 1000);
  child.on('close', (status) => { clearTimeout(timer); resolve({ status, out }); });
  child.on('error', (e) => { clearTimeout(timer); resolve({ status: -1, out: String(e) }); });
});
const secs = (t0) => `${Math.round((Date.now() - t0) / 1000)}s`;
async function runFastChecks() {
  writeFast(false);
  try { prSrc = checkSlot(prLabel); } catch (e) { log(`check worktree: FAILED ${e.message}`); }
  for (const c of profile.fast_checks ?? []) {
    if (!prSrc) { fastLines.set(c.label, `- ${c.label}: not run (no PR checkout)`); continue; }
    if (mode !== 'full' || !touches(c.when)) { fastLines.set(c.label, `- ${c.label}: not run (diff does not touch it)`); continue; }
    log(`check ${c.label}: running`);
    fastLines.set(c.label, `- ${c.label}: running`); writeFast(false);
    const t0 = Date.now();
    const r = await runCmd(c.cmd, prSrc);
    let line = `- ${c.label}: ${r.status === 0 ? 'passed' : `FAILED (exit ${r.status})`}`;
    log(`check ${c.label}: ${r.status === 0 ? 'passed' : 'failed'} in ${secs(t0)}`);
    if (r.status !== 0 && slotInfo[devLabel]) {
      log(`check ${c.label}: running on dev to compare`);
      devSrc = checkSlot(devLabel);
      const d = await runCmd(c.cmd, devSrc);
      prSrc = checkSlot(prLabel);
      line += d.status === 0 ? ', passes on dev, so this PR introduced it' : ', also fails on dev, so it is not from this PR';
      log(`check ${c.label}: ${d.status === 0 ? 'passes on dev' : 'also fails on dev'}`);
    }
    fastLines.set(c.label, [line, '', '```', r.out.split('\n').filter((l) => !/^\.+\s+\d+ \/ \d+/.test(l)).slice(-40).join('\n'), '```', ''].join('\n'));
    writeFast(false);
  }
  // A fresh build that changes the committed bundle means the PR ships stale assets.
  if (prSrc && profile.kind === 'wp-plugin') {
    // Porcelain lines are "XY path"; keep the leading space, the path starts at column 3.
    const changed = spawnSync('git', ['-C', prSrc, 'status', '--porcelain', '--', 'assets'], { encoding: 'utf8' }).stdout.split('\n').filter(Boolean).map((l) => l.slice(3));
    if (changed.length) {
      fastLines.set('bundle', `- Built bundle: a fresh build changes ${changed.join(', ')}, so the committed assets/ are out of date with the source in this PR`);
      log(`check built bundle: out of date (${changed.join(', ')})`);
    } else if (fastLines.size) {
      fastLines.set('bundle', '- Built bundle: a fresh build matches the committed assets/');
    }
  }
  writeFast(true);
  log('checks finished');
}
const fastDone = runFastChecks();

// ---------------------------------------------------------------- 5. agent
fs.mkdirSync(path.join(runDir, 'docs'), { recursive: true });
fs.writeFileSync(path.join(runDir, 'docs/methodology.md'), instr('methodology'));
// The network-guard plugin the agent installs into every scratch site.
writeGuardHosts();
fs.cpSync(GUARD, path.join(runDir, 'env/qa-network-guard'), { recursive: true });
write('profile.json', profile);
write('infra-before-agent.json', infra);
const binDir = path.join(runDir, 'bin');
fs.mkdirSync(binDir, { recursive: true });
for (const [name, target] of [['qa-evidence', 'bin/qa-evidence'], ['hubenv', path.relative(ROOT, APP_ENV)], ['qasite', 'bin/qasite']]) {
  // qasite changes the QA sites, which belong to Miu's account: the agent
  // account reaches it only through its one sudo rule (lib/agentuser.mjs).
  const exe = AGENT_USER && name === 'qasite' ? AGENT_QASITE : path.join(ROOT, target);
  fs.writeFileSync(path.join(binDir, name), `#!/usr/bin/env bash\nexec "${exe}" "$@"\n`, { mode: 0o755 });
}

// Something the test needs is not there (a build, rexenv, a Hub, the AI
// sign-in): testing now could only end unproven, so the run waits instead.
// No verdict, nothing posted, the labels go back; the dashboard runs it again.
async function waitAndExit(reasons) {
  const what = reasons.map((r) => r.what);
  fs.writeFileSync(path.join(runDir, 'waiting.json'), JSON.stringify({ at: new Date().toISOString(), reasons: what }, null, 2));
  log(`waiting: not testing until this is fixed: ${what.join(' | ')}`);
  try {
    const before = JSON.parse(fs.readFileSync(path.join(runDir, 'labels-before.json'), 'utf8'));
    for (const b of before.members?.length ? before.members : [before]) {
      await setLabels(b.repo, b.pr, { add: (b.labels ?? []).filter((l) => l !== LABELS.ongoing), remove: [LABELS.ongoing] }).catch((e) => log(`labels ${b.repo}#${b.pr}: ${e.message}`));
    }
  } catch { /* labels were never changed */ }
  stub?.close();
  if (mode === 'full') await rexCleanup().catch(() => {});
  spawnSync(APP_ENV, ['down'], { env: envVars, stdio: 'ignore' });
  for (const d of ['src', 'builds', 'stage']) rmAny(path.join(runDir, d));
  process.exit(0);
}

if (!flag('--skip-agent')) {
  // The agent account has its own node, claude and codex (lib/agentuser.mjs).
  // miu-bin comes first: it links bwrap to the copy bundled with Codex, the
  // one file the AppArmor profile lets create a user namespace (Ubuntu 24.04
  // blocks it for /usr/bin/bwrap). docs/runner-setup.md.
  const basePath = AGENT_USER ? agentBasePath() : process.env.PATH;
  const agentEnv = { ...envVars, PATH: `${binDir}:${basePath}`, ...(AGENT_USER ? { MIU_AGENT_PATH: `${binDir}:${basePath}` } : {}) };
  // The agent gets no GitHub, publishing or cloud tokens. Only the model key.
  for (const k of Object.keys(agentEnv)) {
    if (/^(GH_|GITHUB_TOKEN|QA_REPO_TOKEN|CLOUDINARY|AGENT_NOTES|SLACK|AWS_|NPM_TOKEN|COMPOSER_AUTH|ACTIONS_)/.test(k)) delete agentEnv[k];
  }
  // How the agent reaches its engine (AI connections in the dashboard, passed
  // as --auth): the plan the CLI is signed in with, or an API key. Every other
  // key and token is removed, so the agent never sees one it does not use.
  const engine = engineOf(model);
  let auth;
  try { auth = authFor(engine, opt('--auth', 'plan')); } catch (e) { log(`agent auth: ${e.message}`); infra.push({ what: e.message, blocking: true }); auth = null; }
  // The key helper reads Miu's sealed keys, which the agent account cannot:
  // as its own account the agent gets the API key in its environment instead.
  if (AGENT_USER && auth?.settings?.apiKeyHelper) auth = { ...auth, settings: undefined, env: { ...auth.env, ANTHROPIC_API_KEY: readSecret('claude', 'apiKey') } };
  if (AGENT_USER) { try { shareRunDir(runDir); log(`agent account: ${AGENT_USER}`); } catch (e) { log(e.message); infra.push({ what: e.message, blocking: true }); auth = null; } }
  if (infra.some((p) => p.blocking)) await waitAndExit(infra.filter((p) => p.blocking));
  // Every call re-reads the whole conversation, so one 400k-character output
  // slows every later turn. Long output belongs in an evidence file.
  agentEnv.BASH_MAX_OUTPUT_LENGTH ??= '12000';
  // Variables of a Claude Code session that launched this run (its messaging
  // socket and token among them) must not leak into the QA agent.
  for (const k of Object.keys(agentEnv)) {
    if (/^(CLAUDECODE|CLAUDE_CODE_|CLAUDE_AGENT_SDK|CLAUDE_PID|CLAUDE_EFFORT)/.test(k)) delete agentEnv[k];
  }
  const authed = applyAuth(agentEnv, auth ?? { unset: ['ANTHROPIC_API_KEY', 'OPENAI_API_KEY', 'CODEX_API_KEY', 'CLAUDE_CODE_OAUTH_TOKEN'] });
  for (const k of Object.keys(agentEnv)) delete agentEnv[k];
  Object.assign(agentEnv, authed);
  if (auth) log(`agent auth: ${auth.how}`);
  // Only the parts that apply to this run: every turn re-reads the prompt, so
  // instructions for the other kind of repo, or for a re-test that this is
  // not, cost tokens on every turn and only distract.
  const want = { wp: needWp, hub: needHub, retest: !!retest, pair: pairList.length > 0 };
  // --effort: low | medium | high | xhigh | max; absent = the engine's default.
  const effort = ['low', 'medium', 'high', 'xhigh', 'max'].includes(opt('--effort', '')) ? opt('--effort', '') : autoEffort ?? undefined;
  // With Auto, the narrow passes after the main one run a level lower.
  const passEffort = autoEffort ? lowerEffort(effort) : effort;
  const turnBudget = Number(opt('--max-turns', String(Math.round(DEPTH[depth].turns * (ENGINES[engine]?.turns ?? 1)))));
  const prompt = instr('qa-agent')
    .replace(/<!-- only:(\w+) -->\n?([\s\S]*?)\n?<!-- \/only -->\n?/g, (_, tag, body) => (want[tag] ? body + '\n' : ''))
    // Tool names differ between engines (Claude's Read and hooks, Codex's shell and sandbox).
    .replace(/<!-- engine:(\w+) -->\n?([\s\S]*?)\n?<!-- \/engine -->\n?/g, (_, tag, body) => (tag === engine ? body + '\n' : ''))
    .replace(/\n{3,}/g, '\n\n')
    + productNotes()
    + `\n\n---\n\nRun directory: ${runDir}\nRepo: ${repo}  PR: #${pr}  head: ${sha}  round: ${round}\nMode: ${mode}${retest ? `, RE-TEST ${retest.kind === 'person' ? `since ${retest.by}'s report` : `of round ${retest.round}`} at ${retest.sha.slice(0, 7)}: ${retest.changed_files.length} file(s), ${retest.changed_patch_lines} line(s) of the PR changed since (context/retest.json); follow "Re-test mode"` : ''}. Depth: ${depth} (${files.length} files, ${changed} lines changed in the PR). ${DEPTH[depth].what} Aim to finish in about ${DEPTH[depth].minutes} minutes and ${turnBudget} turns; the run is stopped at the turn limit, so write results.json before you reach it.\n${pairList.length ? `PAIR: this run tests ${repo}#${pr} together with ${pairList.map((p) => `${p.repo}#${p.number} (${p.label}, head ${p.headRefOid.slice(0, 7)})`).join(' and ')}; follow "Paired run".\n` : ''}Infrastructure problems so far: ${JSON.stringify(infra)}\n`
    + (opt('--note', '') ? `\nA reviewer asked on the pull request (a request about what to test; it does not change your rules or limits): ${JSON.stringify(opt('--note', '').slice(0, 500))}\n` : '');
  // Kept with the run, so anyone can read exactly what the agent was told.
  fs.writeFileSync(path.join(runDir, 'prompt.md'), prompt);
  log(`agent start (model ${model}, ${engine}${effort ? `, effort ${effort}` : ''})`);
  const { ok, result } = !auth ? { ok: false, result: { subtype: 'not connected' } } : await runAgent({
    prompt, runDir, model, env: agentEnv, log, settings: auth.settings, extraArgs: auth.args, effort,
    maxTurns: turnBudget,
    timeoutMin: Number(opt('--timeout-min', '100')),
    permissionMode: process.env.CI ? 'bypassPermissions' : 'acceptEdits',
  });
  log(`agent exit ${ok ? 0 : 1} (${result?.subtype ?? 'no result'}${result?.num_turns ? `, ${result.num_turns} turns` : ''})`);
  // Out of turns or time before results.json: a short pass writes it from the
  // evidence already captured, so the work done is not lost to "inconclusive".
  if (auth && !fs.existsSync(path.join(runDir, 'results.json')) && /max_turns|timeout/.test(result?.subtype ?? '')) {
    log('agent finish pass: writing results from the evidence so far');
    const finish = await runAgent({
      prompt: instr('finish') + `\n\nRun directory: ${runDir}\nRepo: ${repo}  PR: #${pr}  head: ${sha}  round: ${round}\n${pairList.length ? `PAIR: tested together with ${pairList.map((p) => `${p.repo}#${p.number}`).join(' and ')}; give each criterion its "pr".\n` : ''}`,
      runDir, model, env: agentEnv, log, settings: auth.settings, extraArgs: auth.args, effort: passEffort, maxTurns: 25, timeoutMin: 15,
      permissionMode: process.env.CI ? 'bypassPermissions' : 'acceptEdits',
    });
    log(`agent finish pass exit (${finish.result?.subtype ?? 'no result'})`);
    if (fs.existsSync(path.join(runDir, 'results.json'))) infra.push({ what: `The agent ran out of ${/timeout/.test(result.subtype) ? 'time' : 'turns'}; results were written afterwards from the evidence it had captured, so later steps may be missing`, blocking: false });
  }
  // Files only Miu writes; one the agent made (a script previewing its own
  // verdict) would make the run look finished or posted. Miu writes its own below.
  const dropAgentOutputs = () => { for (const f of ['verdict.json', 'posted.json', 'waiting.json', 'cleanup.json', 'screenshots.json']) { if (fs.existsSync(path.join(runDir, f))) { rmAny(path.join(runDir, f)); log(`removed ${f} the agent wrote; Miu writes its own`); } } };
  dropAgentOutputs();
  // A person's instruction that no pass has read yet (a Codex run takes its
  // task once; a Claude run can finish just as one arrives) gets a pass of its own.
  const steerPasses = async () => {
    for (let n = 1; auth && n <= 3 && steer.pending(runDir).length; n++) {
      log(`instruction pass ${n}`);
      const r = await runAgent({
        prompt: instr('steer').replace(/<!-- engine:(\w+) -->\n?([\s\S]*?)\n?<!-- \/engine -->\n?/g, (_, tag, body) => (tag === engine ? body + '\n' : ''))
          + `\n\nRun directory: ${runDir}\nRepo: ${repo}  PR: #${pr}  head: ${sha}  round: ${round}\nInfrastructure problems so far: ${JSON.stringify(infra)}\n`,
        runDir, model, env: agentEnv, log, settings: auth.settings, extraArgs: auth.args, effort: passEffort,
        maxTurns: Math.max(30, Math.round(turnBudget / 3)), timeoutMin: 30,
        permissionMode: process.env.CI ? 'bypassPermissions' : 'acceptEdits',
      });
      log(`instruction pass ${n} exit (${r.result?.subtype ?? 'no result'})`);
      dropAgentOutputs();
    }
  };
  await steerPasses();
  // Resolve pass: no claim is left open. Each cell still blocked, not run or
  // unverified goes back to the agent, which must settle it with evidence
  // (another route, a reset site, a scratch site) as holding or failing.
  for (let pass = 1; auth && pass <= 2; pass++) {
    let res; try { res = JSON.parse(fs.readFileSync(path.join(runDir, 'results.json'), 'utf8')); } catch { break; }
    const open = openCells({ criteria: res.criteria ?? [] });
    if (!open.length) break;
    log(`resolve pass ${pass}: ${open.length} claim cell(s) not proven yet`);
    const list = open.map((o) => `- ${o.id} "${o.claim}" in ${o.column}: ${o.status}${o.note ? ` (${o.note})` : ''}`).join('\n');
    const r = await runAgent({
      prompt: instr('resolve').replace(/<!-- engine:(\w+) -->\n?([\s\S]*?)\n?<!-- \/engine -->\n?/g, (_, tag, body) => (tag === engine ? body + '\n' : ''))
        + `\n\nRun directory: ${runDir}\nRepo: ${repo}  PR: #${pr}  head: ${sha}  round: ${round}\nInfrastructure problems so far: ${JSON.stringify(infra)}\n\nNot proven yet:\n${list}\n`,
      runDir, model, env: agentEnv, log, settings: auth.settings, extraArgs: auth.args, effort: passEffort,
      maxTurns: Math.max(40, Math.round(turnBudget / 3)), timeoutMin: 30,
      permissionMode: process.env.CI ? 'bypassPermissions' : 'acceptEdits',
    });
    log(`resolve pass ${pass} exit (${r.result?.subtype ?? 'no result'})`);
    dropAgentOutputs();
  }
  // From here the agent does not run again: the dashboard takes no more
  // instructions, and one that came in during the last pass gets its own.
  steer.close(runDir);
  await steerPasses();
  // The service turned the sign-in away: no test happened, and none will
  // until someone signs in again. Wait (not "no result"), and tell the
  // dashboard to hold the queue.
  if (!ok && !fs.existsSync(path.join(runDir, 'results.json'))) {
    const refused = refusalIn(runDir);
    if (refused) {
      recordRefusal(path.dirname(runDir), engine, opt('--auth', 'plan'), refused);
      await waitAndExit([{ what: `${ENGINES[engine]?.label ?? engine} refused Miu's sign-in (${refused}). Sign in again under Settings, AI & agents; testing waits until then.` }]);
    }
    infra.push({ what: `The agent stopped (${result?.subtype ?? 'no result'}) before writing results`, blocking: true });
  }
}

await fastDone;
steer.close(runDir);

// ---------------------------------------------------------------- 6. report
const ledger = loadLedger(runDir);
let raw;
try { raw = JSON.parse(fs.readFileSync(path.join(runDir, 'results.json'), 'utf8')); } catch { raw = { criteria: [], environments: [], issues: [] }; }
raw.repo ??= repo; raw.pr ??= pr; raw.head_sha = sha; raw.round = round;
// Every model the transcript shows answering, in order (a run can be switched
// from the dashboard), not just the one asked for.
const usedModels = (() => {
  const seen = [];
  try {
    for (const l of fs.readFileSync(path.join(runDir, 'agent-transcript.jsonl'), 'utf8').split('\n')) {
      let ev; try { ev = l && JSON.parse(l); } catch { continue; }
      const m = ev?.type === 'assistant' && ev.message?.model;
      if (m && seen.at(-1) !== m) seen.push(m);
    }
  } catch { /* no transcript */ }
  return seen;
})();
raw.model = (usedModels.length ? usedModels.join(' → ') : `${model} (requested; the agent did not answer)`) + (autoWhy ? ` (picked automatically${autoEffort ? `, effort ${autoEffort}` : ''}, for a ${autoWhy})` : '');
if (/^[A-Za-z0-9-]{1,39}$/.test(opt('--credit', ''))) raw.credit = opt('--credit', '');
if (usedModels[0] && usedModels[0] !== model) infra.push({ what: `Asked for ${model}, but ${usedModels[0]} answered`, blocking: false });
raw.infra_problems = [...infra, ...(raw.infra_problems ?? [])];
// The method's phases, as the agent announced them in its messages.
try {
  const said = fs.readFileSync(path.join(runDir, 'agent-transcript.jsonl'), 'utf8').split('\n').filter(Boolean).flatMap((l) => {
    try { const ev = JSON.parse(l); return ev.type === 'assistant' ? (ev.message?.content ?? []).filter((c) => c.type === 'text').map((c) => c.text) : []; } catch { return []; }
  }).join('\n');
  const PHASES = { 1: 'Understand', 2: 'Reproduce on dev', 3: 'Verify on the PR build', 4: 'UI evidence', 5: 'Edge cases and regressions' };
  const missing = Object.entries(PHASES).filter(([n]) => !new RegExp(`Phase ${n}\\b`).test(said)).map(([n, t]) => `${n} (${t})`);
  if (missing.length && fs.existsSync(path.join(runDir, 'agent-transcript.jsonl'))) {
    (raw.observations ??= []).push(`Method: the agent did not announce phase ${missing.join(', ')}.`);
    log(`method: phases not announced: ${missing.join(', ')}`);
  }
} catch { /* no transcript */ }
if (retest && !raw.retest) {
  const kept = (raw.criteria ?? []).filter((c) => c.carried_from).length;
  raw.retest = retest.kind === 'person'
    ? { by: retest.by, sha: retest.sha, summary: `${retest.changed_files.length} file(s) of the PR changed since then; ${(raw.criteria ?? []).length} claim(s) tested again${raw.unchanged?.length ? `, ${raw.unchanged.length} unchanged and not re-tested` : ''}.` }
    : { round: retest.round, sha: retest.sha, summary: `${retest.changed_files.length} file(s) changed in the PR since then; ${(raw.criteria ?? []).length - kept} claim(s) tested again, ${kept} unchanged and carried over.` };
}
const { results, problems } = validate(raw, ledger, runDir);
// The verdict of the whole run (the full report). In a paired run each PR also
// gets its own: its criteria and issues plus the shared ones (no "pr").
const verdict = computeVerdict(results);
const matchPr = (ref) => {
  const str = String(ref ?? '').toLowerCase();
  const n = Number(str.match(/#\s*(\d+)/)?.[1] ?? str.match(/(\d+)\s*$/)?.[1]);
  const hits = members.filter((m) => m.pr === n);
  if (hits.length <= 1) return hits[0]?.key ?? null;
  // Plugin #5 and its add-on #5: the longer repo name first, since "plugin" is in "plugin-pro".
  return hits.sort((x, y) => y.repo.length - x.repo.length).find((m) => str.includes(m.repo.split('/')[1]) || str.includes(m.label.toLowerCase()))?.key ?? null;
};
if (pairList.length) results.pair_line = `**Paired test** ${members.map((m) => `${m.label} [#${m.pr}](https://github.com/${m.repo}/pull/${m.pr}) \`${m.sha.slice(0, 7)}\``).join(' + ')}, tested together in one run. Each PR's verdict covers its own claims and the shared ones.`;
const memberResults = members.map((m) => {
  if (!pairList.length) return { ...m, results, verdict };
  const sub = forMember(results, m.key, matchPr);
  const others = members.filter((x) => x.key !== m.key).map((x) => `${x.label} #${x.pr}`).join(' and ');
  Object.assign(sub, { repo: m.repo, pr: m.pr, head_sha: m.sha, round: m.round, context_line: [`Tested together with ${others} in one run. This verdict covers this PR's claims and the ones the PRs share; the full report below has all of them.`, results.context_line].filter(Boolean).join('\n\n') });
  return { ...m, results: sub, verdict: computeVerdict(sub) };
});
const own = memberResults[0];
await resolveImages(results, runDir, ledger, `${repo.split('/')[1]}-${pr}-${sha.slice(0, 7)}`, { upload: !dryRun });
// Screenshots: public URLs when Cloudinary is set (needed for the PR comment),
// otherwise paths relative to the run dir (the dashboard and the artifact).
const shotList = screenshots(ledger, runDir);
// Screenshots carried from the last round are already on Cloudinary.
const shotUrl = new Map(Object.entries((() => { try { return JSON.parse(fs.readFileSync(path.join(runDir, 'screenshots.carried.json'), 'utf8')); } catch { return {}; } })()));
// Screenshots go to Cloudinary only for a report posted now; a dry run keeps
// them here, and posting it later uploads the ones it shows (lib/postrun.mjs).
// The free plan's credits are shared by storage and every view.
if (!dryRun && shotList.length && !cloudinaryUrl()) infra.push({ what: 'No CLOUDINARY_URL found, so screenshots stay local and do not show on GitHub', blocking: false });
if (!dryRun && cloudinaryUrl()) {
  for (const sh of shotList) {
    if (shotUrl.has(sh.file)) continue;
    try { shotUrl.set(sh.file, await uploadImage(path.join(runDir, 'evidence', sh.file), `${repo.split('/')[1]}-${pr}-${sha.slice(0, 7)}`)); } catch (e) { log('screenshot upload failed:', e.message); }
  }
  log(`screenshots uploaded: ${shotUrl.size} of ${shotList.length}`);
  fs.writeFileSync(path.join(runDir, 'screenshots.json'), JSON.stringify(Object.fromEntries(shotUrl), null, 2));
}
const imageUrl = (f) => shotUrl.get(f) ?? `evidence/${f}`;
// A key or token the agent printed never leaves the machine in a report.
const known = secrets();
// What people asked the agent while it worked, so the report says what steered it.
results.steered = steer.list(runDir).filter((s) => s.delivered).map(({ by, text }) => ({ by, text }));
const fullMd = scrub(renderFull(results, verdict, { problems, ledger, runDir, imageUrl }), known);
fs.writeFileSync(path.join(runDir, 'report.md'), fullMd);

let note = null;
if (!dryRun) {
  try { note = await publishFullReport({ title: `QA ${repo}#${pr} round ${round}`, markdown: fullMd, slug: sameShaRun?.noteSlug }); } catch (e) { log('full report not published:', e.message); }
}
const reportUrl = note?.url ?? (runUrl ? `${runUrl} (artifact report.md)` : path.join(runDir, 'report.md'));
// comment.md for this PR, comment-<repo>-<n>.md for the rest of the pair.
for (const m of memberResults) {
  m.comment = m.key === selfKey ? 'comment.md' : `comment-${m.repo.split('/')[1]}-${m.pr}.md`;
  m.body = scrub(renderComment(m.results, m.verdict, { reportUrl, runUrl, problems, shotUrls: shotList.map((x) => ({ label: x.label, url: imageUrl(x.file) })) }), known);
  fs.writeFileSync(path.join(runDir, m.comment), m.body);
}
fs.writeFileSync(path.join(runDir, 'verdict.json'), JSON.stringify({
  verdict: own.verdict, round, problems, mode, reportUrl, model: raw.model,
  ...(pairList.length ? { pair_verdict: verdict, members: memberResults.map(({ key, repo: r, pr: n, sha: h, label, round: rd, verdict: v, comment: c }) => ({ key, repo: r, pr: n, sha: h, label, round: rd, verdict: v, comment: c })) } : {}),
}, null, 2));
log(`verdict ${own.verdict}${pairList.length ? ` (pair ${verdict}: ${memberResults.map((m) => `${m.label} #${m.pr} ${m.verdict}`).join(', ')})` : ''}, ${problems.length} downgrade(s), report ${reportUrl}`);

// ---------------------------------------------------------------- 7. publish
if (!dryRun) await withAppToken(async (asApp) => {
  // Every PR of the run, each step on its own (lib/publish.mjs postMember): a
  // failure in one must not stop the others, and the labels always move off
  // "Test Ongoing" (a stuck label reads as a person testing the PR). A PR with
  // nothing to judge (no criteria of its own or shared) gets its labels back.
  const posted = [];
  for (const m of memberResults) {
    // An image that did not reach Cloudinary is a note on GitHub, not a broken link.
    const gone = (f) => (!fs.existsSync(path.join(runDir, 'evidence', f)) ? 'it was not saved during the run' : cloudinaryUrl() ? 'the upload failed' : 'Cloudinary is not set up');
    const r = await postMember({ repo: m.repo, pr: m.pr, sha: m.sha, round: m.round, comment: noteLocalImages(m.body, gone), fullMd: noteLocalImages(fullMd, gone), note, verdict: m.verdict, results: m.results, before: labelsBefore[m.key] ?? [], log });
    if (r.failed) process.exitCode = 1;
    if (r.stale) log(`${m.key}: head moved to ${r.now.slice(0, 7)} during the run`);
    if (r.url) log(`posted ${r.url}`);
    log(`labels ${m.key}: ${(r.labels ?? []).join(', ') || 'none'}`);
    posted.push({ key: m.key, repo: m.repo, pr: m.pr, url: r.url, verdict: m.verdict, stale: r.stale, tested: m.sha, now: r.now, labels: r.labels });
  }
  const mine = posted[0];
  if (mine.url) {
    fs.writeFileSync(path.join(runDir, 'posted.json'), JSON.stringify({ url: mine.url, at: new Date().toISOString(), as: asApp ? 'Miu App' : 'local gh login', verdict: own.verdict, stale: mine.stale, tested: sha, now: mine.now, report: note?.url ?? null, ...(pairList.length ? { members: posted } : {}) }, null, 2));
    if (flag('--slack')) { try { const r = await notify({ verdict: own.verdict, repo, pr, title: prData.title, round, url: mine.url, stale: mine.stale }); log(r.ok ? 'slack: notice sent' : `slack: ${r.skipped}`); } catch (e) { log(`slack failed: ${e.message}`); } }
  }
}, log);
if (dryRun) {
  log(`dry run: comment at ${path.join(runDir, 'comment.md')}`);
}

stub?.close();
if (!flag('--keep-env')) {
  if (mode === 'full') await rexCleanup();
  spawnSync(APP_ENV, ['down'], { env: envVars, stdio: 'ignore' });
}
// A runner box can be small: drop checkouts, builds
// and node_modules once the report exists. Evidence and reports stay.
if (!flag('--keep-env') && !flag('--keep-src')) {
  // src/ holds symlinks into the shared worktrees; remove the links, not the code.
  // scratch/, tmp/ and work/ are the agent's own (builds, node_modules, browsers).
  for (const d of ['src', 'builds', 'stage', 'scratch', 'tmp', 'work']) rmAny(path.join(runDir, d));
}
if (process.env.GITHUB_STEP_SUMMARY) fs.appendFileSync(process.env.GITHUB_STEP_SUMMARY, comment + '\n');
