const GH_ICON = '<svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>';
const authPage = (title, { heading, sub = '', message = '', body, foot = '' }, status = 200) => (res) => {
  res.writeHead(status, { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store' });
  res.end(`<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title>${escHtml(title)} | Miu</title><link rel="icon" href="/brand/miu-favicon.svg"><style>${AUTH_CSS}</style>
<main><div class="card"><img class="mark l" src="/brand/miu-mark-black.svg" alt="Miu"><img class="mark d" src="/brand/miu-mark-white.svg" alt="Miu">
<h1>${heading}</h1>${sub ? `<p class="sub">${sub}</p>` : ''}${message ? `<p class="bad" role="alert">${escHtml(message)}</p>` : ''}${body}${foot ? `<p class="foot">${foot}</p>` : ''}</div>
<footer>Miu, pull request QA</footer></main><script>
// The page asked for (#settings, a run) is after the # and never reaches the server: carry it through sign-in.
if (location.hash) {
  document.querySelectorAll('input[name=next]').forEach((i) => { i.value = i.value.split('#')[0] + location.hash; });
  document.querySelectorAll('a[href^="/auth/github"]').forEach((a) => { const u = new URL(a.href); if (!u.searchParams.has('invite')) { u.searchParams.set('next', (u.searchParams.get('next') || '/').split('#')[0] + location.hash); a.href = u.pathname + u.search; } });
}
</script></html>`);
};
// [name, placeholder, type, extra attributes, value]
const fieldsHtml = (fs) => fs.map(([name, label, type = 'text', extra = '', value = '']) => `<input name="${name}" type="${type}" placeholder="${label}" aria-label="${label}" ${value ? `value="${escHtml(value)}"` : ''} ${extra} required>`).join('');
function loginPage(res, message = '', next = '/', email = '') {
  const cfg = authCfg();
  if (!users.hasUsers()) return setupPage(res, message);
  const gh = cfg.ready ? `<div class="or">OR</div><a class="btn alt" href="/auth/github?next=${encodeURIComponent(next)}">${GH_ICON}Continue with GitHub</a>` : '';
  return authPage('Sign in', {
    heading: 'Welcome back',
    sub: 'Sign in to Miu.',
    message,
    body: `<form method="post" action="/auth/login"><input type="hidden" name="next" value="${escHtml(next)}">${fieldsHtml([['email', 'Email address', 'email', `autocomplete="username" ${email ? '' : 'autofocus'}`, email], ['password', 'Password', 'password', `autocomplete="current-password" ${email ? 'autofocus' : ''}`]])}<button>Continue</button></form>${gh}`,
    foot: 'No account? Ask a Miu admin for an invite.',
  }, 401)(res);
}
function setupPage(res, message = '', f = {}) {
  return authPage('Set up', {
    heading: 'Set up Miu',
    sub: 'Create the owner account. You can invite your team after.',
    message,
    body: `<form method="post" action="/auth/setup"><input type="hidden" name="next" value="/">${fieldsHtml([['code', 'Setup code', 'text', 'autocomplete="one-time-code" spellcheck="false" autofocus', f.code]])}<p class="hint">Find it in the server log, or in <code>~/.config/miu/setup-code</code></p>${fieldsHtml([['name', 'Your name', 'text', 'autocomplete="name"', f.name], ['email', 'Email address', 'email', 'autocomplete="username"', f.email], ['password', 'Password', 'password', 'autocomplete="new-password" minlength="10"']])}<p class="hint">At least 10 characters.</p><button>Create account</button></form>`,
  })(res);
}
function invitePage(res, token, message = '') {
  const cfg = authCfg();
  const inv = users.inviteFor(token);
  if (!inv) return authPage('Invite', { heading: 'This invite has expired', sub: 'It was used already, or it is older than 7 days. Ask a Miu admin for a new one.', body: '<a class="btn" href="/auth/login">Go to sign in</a>' }, 404)(res);
  const who = inv.email ?? inv.github;
  const body = inv.github && !inv.email
    ? (cfg.ready ? `<a class="btn" href="/auth/github?invite=${encodeURIComponent(token)}">${GH_ICON}Continue with GitHub</a>` : '<p class="bad">GitHub sign-in is not set up on this Miu yet. Ask an admin to invite you by email instead.</p>')
    : `<form method="post" action="/auth/invite/${escHtml(token)}"><input type="email" value="${escHtml(inv.email)}" aria-label="Email address" disabled>${fieldsHtml([['name', 'Your name', 'text', 'autocomplete="name" autofocus'], ['password', 'Choose a password', 'password', 'autocomplete="new-password" minlength="10"']])}<p class="hint">At least 10 characters.</p><button>Join Miu</button></form>`;
  return authPage('Join', { heading: 'Join Miu', sub: `<b>${escHtml(inv.by)}</b> invited ${escHtml(who)} as ${inv.role === 'admin' ? 'an' : 'a'} <b>${escHtml(inv.role)}</b>.`, message, body })(res);
}
// A form posted to these pages must come from this site.
function sameSite(req) {
  const o = req.headers.origin || req.headers.referer || '';
  if (!o) return false;
  try { const u = new URL(o); return u.host === req.headers.host || u.origin === new URL(authCfg().publicUrl).origin; } catch { return false; }
}
function readForm(req) {
  return new Promise((resolve) => {
    let body = '';
    req.on('data', (c) => { body += c; if (body.length > 8000) req.destroy(); });
    req.on('end', () => resolve(Object.fromEntries(new URLSearchParams(body))));
  });
}
// Who is asking, for the sign-in throttle. The first X-Forwarded-For entry is
// whatever the client wrote; only the proxy in front of Miu (on this machine)
// is believed: its X-Real-IP, or the entry it appended last.
const clientIp = (req) => {
  const peer = req.socket.remoteAddress || '';
  if (!/^(127\.|::1$|::ffff:127\.)/.test(peer)) return peer;
  return String(req.headers['x-real-ip'] || String(req.headers['x-forwarded-for'] || '').split(',').pop() || peer).trim();
};
const signIn = (res, user, next = '/') => {
  res.writeHead(302, { 'Set-Cookie': auth.sessionCookie(sessions.create({ uid: user.id, login: user.github || user.email, name: user.name, avatar: user.avatar }), authCfg()), Location: next.startsWith('/') && !next.startsWith('//') ? next : '/' });
  res.end();
  users.touch(user.id);
  console.log(`signed in: ${user.name} (${user.role})`);
};

const server = http.createServer((req, res) => {
  const url = new URL(req.url, 'http://x');
  securityHeaders(res);
  const json = (o) => { res.writeHead(o ? 200 : 404, { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' }); res.end(JSON.stringify(o)); };
  const cfg = authCfg();
  const session = sessions.get(auth.readCookie(req));
  // Who this is and what they may do: the account's role, read fresh on each
  // request so a change of role or a removal takes effect at once. With
  // sign-in off (this machine, no accounts yet) the person at the keyboard is
  // the owner.
  const me = session?.uid ? users.get(session.uid) : null;
  const role = !cfg.required ? 'owner' : me?.role ?? null;
  if (me) users.touch(me.id);
  const admin = users.atLeast(role, 'admin');
  // ---- sign-in routes
  if (url.pathname === '/auth/setup') {
    if (users.hasUsers()) { res.writeHead(302, { Location: '/' }); return res.end(); }
    if (req.method !== 'POST') { console.log(`Setup code for the owner account: ${users.setupCode()} (also in ~/.config/miu/setup-code)`); return setupPage(res); }
    if (!sameSite(req)) return setupPage(res, 'Send the form from this page.');
    readForm(req).then((f) => { try { signIn(res, users.createOwner(f), f.next || '/'); } catch (e) { setupPage(res, e.message, f); } });
    return;
  }
  if (url.pathname === '/auth/login') {
    if (req.method !== 'POST') return loginPage(res, '', url.searchParams.get('next') || '/');
    if (!sameSite(req)) return loginPage(res, 'Send the form from this page.');
    readForm(req).then((f) => { try { signIn(res, users.signInPassword(f.email, f.password, clientIp(req)), f.next || '/'); } catch (e) { loginPage(res, e.message, f.next || '/', f.email); } });
    return;
  }
  if (url.pathname === '/auth/github') {
    if (!cfg.ready) return loginPage(res, 'GitHub sign-in is not set up on this Miu.');
    res.writeHead(302, { Location: auth.loginRedirect(cfg, url.searchParams.get('next') || '/', url.searchParams.get('invite')) }); return res.end();
  }
  if (url.pathname === '/auth/callback') {
    if (!cfg.ready) return loginPage(res);
    auth.finishLogin(cfg, url).then(({ github, next, invite }) => {
      let user = users.signInGithub(github.login);
      if (!user && invite) user = users.acceptInvite(invite, { name: github.name, githubLogin: github.login });
      if (!user) return loginPage(res, `${github.login} is not a member of this Miu. Ask an admin for an invite.`);
      signIn(res, user, next);
    }).catch((e) => loginPage(res, e.message));
    return;
  }
  let m0 = url.pathname.match(/^\/auth\/invite\/([\w-]{20,64})$/);
  if (m0) {
    if (req.method !== 'POST') return invitePage(res, m0[1]);
    if (!sameSite(req)) return invitePage(res, m0[1], 'Send the form from this page.');
    readForm(req).then((f) => { try { signIn(res, users.acceptInvite(m0[1], { name: f.name, password: f.password })); } catch (e) { invitePage(res, m0[1], e.message); } });
    return;
  }
  if (url.pathname === '/auth/logout' && req.method === 'POST' && req.headers['x-qa-dashboard'] === '1') {
    sessions.drop(auth.readCookie(req));
    res.writeHead(200, { 'Set-Cookie': auth.clearCookie(cfg), 'Content-Type': 'application/json' }); return res.end('{"ok":true}');
  }
  // The gate: with sign-in on, nothing but the sign-in pages and the logo
  // without an account. Before the first account, the set-up page; the
  // GitHub App set-up page only from the machine itself.
  if (cfg.required && !me && !PUBLIC_PATHS.test(url.pathname)) {
    const setup = /^\/(github-app(\/callback)?|api\/app-secret)$/.test(url.pathname) && isLocal(req) && !cfg.ready;
    if (!setup) {
      if (req.method === 'GET' && !url.pathname.startsWith('/api/') && !url.pathname.startsWith('/evidence/')) return users.hasUsers() ? loginPage(res, '', url.pathname + url.search) : setupPage(res);
      res.writeHead(401, { 'Content-Type': 'application/json' }); return res.end('{"error":"Sign in first"}');
    }
  }
  const deny = (msg) => { res.writeHead(403, { 'Content-Type': 'application/json' }); res.end(JSON.stringify({ error: msg })); };
  if (cfg.required && !admin && (ADMIN_ONLY.test(url.pathname) || url.pathname.startsWith('/api/members'))) return deny('Only a Miu admin can change settings and members.');
  // A viewer reads; changing anything (other than their own password) needs member or above.
  if (cfg.required && req.method === 'POST' && !users.atLeast(role, 'member') && url.pathname !== '/api/account/password') return deny('Viewers can read reports. Ask an admin to make you a member to test or post.');
  if (req.method === 'GET' && url.pathname === '/api/me') return json({ auth: cfg.required, ready: cfg.ready, admin, role, user: me ? { id: me.id, login: me.github || me.email, name: me.name, avatar: me.avatar, email: me.email, github: me.github } : null });
  if (req.method === 'GET' && url.pathname === '/api/members') return json(users.list());
  if (req.method === 'GET') {
    if (url.pathname === '/') {
      // Scripts run only with this request's nonce; nothing may frame the page.
      const nonce = crypto.randomBytes(16).toString('base64');
      res.writeHead(200, {
        'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store',
        'Content-Security-Policy': [
          "default-src 'self'", `script-src 'nonce-${nonce}' https://cdnjs.cloudflare.com`, "style-src 'self' 'unsafe-inline'",
          "img-src 'self' data: blob: https://res.cloudinary.com https://github.com https://*.githubusercontent.com https://gravatar.com https://*.gravatar.com",
          "media-src 'self' https://res.cloudinary.com", "connect-src 'self'", "font-src 'self'",
          "frame-ancestors 'none'", "base-uri 'none'", "form-action 'self' https://github.com", "object-src 'none'",
        ].join('; '),
      });
      // The repos the page names, from the profiles; < is escaped so the JSON cannot end the script.
      const known = JSON.stringify({ owner: project().owner, slack: project().slack_channel, repos: [...profiled()].map(([full, p]) => ({ full, name: full.split('/')[1], label: p.label, role: p.role })) }).replace(/</g, '\\u003c');
      return res.end(fs.readFileSync(PAGE_FILE, 'utf8').replace('<script>\n', `<script>\nconst MIU = ${known};\n`).replace(/<script(?=[\s>])/g, `<script nonce="${nonce}"`));
    }
    if (url.pathname === '/api/runs') return json(listRuns());
    if (url.pathname === '/api/fixes') return json(listFixes());
    if (url.pathname === '/api/options') return json({ models: offered(), efforts: EFFORTS, repos: repos(), live: liveRun() });
    if (url.pathname === '/api/instructions') return json(listInstructions(RUNS));
    if (url.pathname === '/api/github-user') return json(ghuser.loginState());
    if (url.pathname === '/api/suggest') { ruleSuggestions().then(json, (e) => json({ error: e.message })); return; }
    if (url.pathname === '/api/screenshots') { shotsUsage().then(json, (e) => json({ error: e.message })); return; }
    if (url.pathname === '/api/connections') {
      // A sign-in the service refused in a run shows as not connected, whatever the CLI says.
      const modes = getConfig().connections ?? {};
      conn.statusAll(modes, { fresh: url.searchParams.has('fresh') }).then((all) => json(all.map((c) => {
        const r = refusal(RUNS, c.engine, modes[c.engine] ?? c.mode);
        return r ? { ...c, ready: false, problem: `${c.label} refused this sign-in in a run (${r.message}). Sign in again.` } : c;
      })), (e) => json({ error: e.message }));
      return;
    }
    if (url.pathname === '/api/prs') return json(prView());
    if (url.pathname === '/api/history') {
      const repo = url.searchParams.get('repo'), n = Number(url.searchParams.get('pr'));
      if (!repos().includes(repo) || !Number.isInteger(n)) return json({ error: 'Unknown pull request' });
      prHistory(repo, n).then(json, (e) => json({ error: e.message }));
      return;
    }
    if (url.pathname === '/api/stats') return json(stats(Math.min(90, Number(url.searchParams.get('days')) || 7)));
    if (url.pathname === '/github-app/profile') return profilePage(url, res);
    if (url.pathname === '/github-app') return void githubAppPage(res).catch((e) => { res.writeHead(500); res.end(e.message); });
    if (url.pathname === '/github-app/callback') return void githubAppCallback(url, res).catch((e) => { res.writeHead(500); res.end(e.message); });
    let m = url.pathname.match(/^\/api\/runs\/([^/]+)$/);
    if (m) return json(safeName(m[1]) && detail(m[1]));
    if (url.pathname === '/brand' || url.pathname === '/brand/') { res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' }); return res.end(fs.readFileSync(path.join(ROOT, 'assets/brand/preview.html'), 'utf8').replace('<meta charset="utf-8">', '<meta charset="utf-8"><base href="/brand/">')); }
    m = url.pathname.match(/^\/brand\/([\w.-]+\.(svg|png))$/);
    if (m) return sendFile(res, path.join(ROOT, 'assets/brand', m[1]));
    m = url.pathname.match(/^\/evidence\/([^/]+)\/([^/]+)$/);
    if (m && safeName(decodeURIComponent(m[1])) && safeName(decodeURIComponent(m[2]))) {
      const runName = decodeURIComponent(m[1]), file = decodeURIComponent(m[2]);
      const local = path.join(RUNS, runName, 'evidence', file);
      // A screenshot pruned from this disk is served from where it was uploaded.
      if (!fs.existsSync(local)) {
        const up = readJson(path.join(RUNS, runName, 'screenshots.json'))?.[file] ?? readJson(path.join(RUNS, runName, 'screenshots.carried.json'))?.[file];
        if (typeof up === 'string' && /^https:\/\/res\.cloudinary\.com\//.test(up)) { res.writeHead(302, { Location: up, 'Cache-Control': 'max-age=86400' }); return res.end(); }
      }
      return sendFile(res, local);
    }
    res.writeHead(404); return res.end();
  }
  if (req.method === 'POST') {
    // Starting a run spends plan usage, so only this page may do it, not
    // another site open in the same browser. The custom header forces a CORS
    // preflight that is never answered, and the Origin must be this server.
    // Writes need the custom header (a cross-site form cannot send it) and,
    // when there is one, an Origin of this server. With sign-in on, the
    // Origin is required and must be the public URL.
    const origin = req.headers.origin ?? '';
    const own = new URL(cfg.publicUrl).origin;
    const originOk = cfg.required ? origin === own : (!origin || origin === own || /^http:\/\/(localhost|127\.0\.0\.1):\d+$/.test(origin));
    if (req.headers['x-qa-dashboard'] !== '1' || !originOk) { res.writeHead(403); return res.end(); }
    let body = '';
    const limit = url.pathname === '/api/instructions' ? 200000 : 10000;
    req.on('data', (c) => { body += c; if (body.length > limit) req.destroy(); });
    req.on('end', () => {
      let data = {}; try { data = JSON.parse(body || '{}'); } catch { /* empty body */ }
      if (url.pathname === '/api/app-secret') {
        try { auth.saveClientSecret(String(data.secret || '').trim()); return json({ ok: true }); } catch (e) { return json({ error: e.message }); }
      }
      if (url.pathname === '/api/config') { setConfig(data).then(json, (e) => json({ error: e.message })); return; }
      if (url.pathname === '/api/profiles/save') { try { saveProfile(String(data.repo || ''), String(data.text || '')); return json({ ok: true }); } catch (e) { return json({ error: e.message }); } }
      if (url.pathname === '/api/profiles') { addProfile(String(data.repo || '').trim()).then((p) => json({ ok: true, repo: p.repo }), (e) => json({ error: e.message.replace(/^GitHub GET [^:]+: /, '') })); return; }
      if (url.pathname === '/api/instructions') { try { return json(saveInstruction(RUNS, data)); } catch (e) { return json({ error: e.message }); } }
      // Members (admin; the gate above checks) and one's own password.
      if (url.pathname === '/api/members/invite') {
        try { const token = users.invite(data, { role, name: me?.name ?? 'the owner' }); return json({ link: `${cfg.publicUrl}/auth/invite/${token}`, ...users.list() }); } catch (e) { return json({ error: e.message }); }
      }
      if (url.pathname === '/api/members/role') { try { return json(users.setRole(String(data.id), String(data.role), { role })); } catch (e) { return json({ error: e.message }); } }
      if (url.pathname === '/api/members/remove') {
        if (me && data.id === me.id) return json({ error: 'You cannot remove yourself. Ask another admin.' });
        try { return json(users.remove(String(data.id), { role })); } catch (e) { return json({ error: e.message }); }
      }
      if (url.pathname === '/api/members/revoke') { users.revokeInvite(String(data.id)); return json(users.list()); }
      if (url.pathname === '/api/account/password') {
        if (!me) return json({ error: 'Sign in first.' });
        try { users.changePassword(me.id, data.current, data.next); return json({ ok: true }); } catch (e) { return json({ error: e.message }); }
      }
      if (url.pathname === '/api/github-user/connect') { ghuser.startLogin().then(json, (e) => json({ error: e.message })); return; }
      if (url.pathname === '/api/github-user/disconnect') return json(ghuser.disconnect());
      if (url.pathname === '/api/github-user/push-token') { ghuser.savePushToken(data.token, repos()).then(json, (e) => json({ error: e.message })); return; }
      // AI connections. A secret comes in once and only its last four characters go back out.
      if (url.pathname === '/api/connections/secret') {
        try { conn.saveSecret(String(data.engine), String(data.kind), data.value); } catch (e) { return json({ error: e.message }); }
        return conn.statusAll(getConfig().connections, { fresh: true }).then(json, (e) => json({ error: e.message }));
      }
      if (url.pathname === '/api/connections/test') {
        if (!ENGINES[data.engine]) return json({ error: 'Unknown engine' });
        conn.test(data.engine, getConfig().connections[data.engine]).then(json, (e) => json({ ok: false, error: e.message })); return;
      }
      // Account sign-in (OAuth). The page to open comes from the CLI; only the
      // two providers' sign-in pages are handed to the browser.
      if (url.pathname === '/api/connections/signin') {
        const start = data.engine === 'codex' ? conn.codexSignIn() : data.engine === 'claude' ? conn.claudeSignIn() : Promise.resolve({ error: 'Unknown engine' });
        start.then((r) => json(r.url && !/^https:\/\/(claude\.com|claude\.ai|auth\.openai\.com)\//.test(r.url) ? { error: 'The sign-in page was not one Miu expects.' } : r), (e) => json({ error: e.message })); return;
      }
      if (url.pathname === '/api/connections/code') { conn.claudeCode(data.code).then(json, (e) => json({ error: e.message })); return; }
      if (url.pathname === '/api/connections/signout') { (data.engine === 'codex' ? conn.codexSignOut() : Promise.resolve({ error: 'Unknown engine' })).then(json, (e) => json({ error: e.message })); return; }
      if (url.pathname === '/api/refresh') { refreshPrs(); return json({ ok: true }); }
      if (url.pathname === '/api/test') {
        // "Test now" from the list: queue it; it starts at once when nothing runs.
        if (!repos().includes(data.repo) || !Number.isInteger(Number(data.pr))) return json({ error: 'Unknown pull request' });
        return json(enqueue(data.repo, Number(data.pr), 'asked from the dashboard', { full: data.full === true, force: data.force === true }));
      }
      // Change the order of the line: a pull request that matters more can go first.
      if (url.pathname === '/api/queue/move') {
        const i = queue.findIndex((q) => q.repo === data.repo && q.pr === Number(data.pr));
        if (i < 0) return json({ error: 'It is not in the queue any more: it started or was removed.' });
        // A place in the line (dragged there), or top / up / down / bottom.
        const to = Number.isInteger(data.to) ? data.to : { top: 0, up: i - 1, down: i + 1, bottom: queue.length - 1 }[data.to];
        if (to === undefined) return json({ error: 'Move it to a place in the line, or top, up, down or bottom.' });
        const [item] = queue.splice(i, 1);
        queue.splice(Math.max(0, Math.min(queue.length, to)), 0, item);
        saveQueue();
        console.log(`queue: ${data.repo}#${data.pr} moved from ${i + 1} to ${queue.indexOf(item) + 1} by ${me?.name ?? 'the local user'}`);
        return json({ ok: true, queue: queue.map((q) => `${q.repo}#${q.pr}`) });
      }
      if (url.pathname === '/api/unqueue') {
        const i = queue.findIndex((q) => q.repo === data.repo && q.pr === Number(data.pr));
        if (i > -1) { queue.splice(i, 1); saveQueue(); }
        return json({ ok: true });
      }
      if (url.pathname === '/api/start') return json(startRun({ repo: data.repo, pr: Number(data.pr), model: data.model, dryRun: data.dryRun !== false }));
      const rv = url.pathname.match(/^\/api\/runs\/([^/]+)\/review$/);
      if (rv && safeName(rv[1])) { setReview(rv[1], data, session?.login ?? localName).then(json, (e) => json({ error: e.message })); return; }
      const fx = url.pathname.match(/^\/api\/runs\/([^/]+)\/fix$/);
      if (fx && safeName(fx[1])) return json(startFix({ run: fx[1], by: session?.login ?? localName }));
      const fs2 = url.pathname.match(/^\/api\/fixes\/([^/]+)\/stop$/);
      if (fs2 && safeName(fs2[1])) return json(stopFix(fs2[1]));
      const pm = url.pathname.match(/^\/api\/runs\/([^/]+)\/post$/);
      if (pm && safeName(pm[1])) {
        const name = pm[1];
        if (posting.has(name)) return json({ error: 'Already posting this run' });
        posting.add(name);
        postRun(path.join(RUNS, name), { log: (m) => console.error(`post ${name}: ${m}`) })
          .then(json, (e) => json({ error: e.message.split('\n')[0] }))
          .finally(() => posting.delete(name));
        return;
      }
      const sr = url.pathname.match(/^\/api\/runs\/([^/]+)\/steer$/);
      if (sr && safeName(sr[1])) return json(steerRun(sr[1], data.text, session?.login ?? localName));
      const m = url.pathname.match(/^\/api\/runs\/([^/]+)\/(model|stop)$/);
      if (m && safeName(m[1])) return json(m[2] === 'model' ? switchModel(m[1], data.model) : stopRun(m[1]));
      res.writeHead(404); res.end();
    });
    return;
  }
  res.writeHead(405); res.end();
});
const ADMIN_ONLY = /^\/(api\/config|api\/profiles(\/save)?|github-app\/profile|api\/instructions|api\/github-user(\/[\w-]+)?|api\/app-secret|api\/connections(\/[\w-]+)?|github-app(\/callback)?)$/;
process.on('uncaughtException', (e) => console.error('dashboard error (kept running):', e));
{
  const cfg = authCfg();
  // A new install: the one-time code that makes the owner account (lib/users.mjs).
  if (cfg.required && !users.hasUsers()) console.log(`Miu has no accounts yet. Open ${cfg.publicUrl}/auth/setup and use the setup code ${users.setupCode()} (also in ~/.config/miu/setup-code).`);
  server.listen(PORT, HOST, () => console.log(`Miu: ${cfg.publicUrl}  (listening on ${HOST}:${PORT}, sign-in ${cfg.required ? 'on' : 'off'}, runs from ${RUNS})`));
}


// The page itself. Read per request so edits show on reload.
const PAGE_FILE = path.join(ROOT, 'lib/dashboard.html');
