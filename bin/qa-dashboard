// What the App can reach (when installed), next to what Miu has profiles for.
async function repoRows() {
  const prof = profiled(), on = new Set(repos());
  let reach = null;
  try {
    const { token, kind } = await gh.tokenFor(appOwner());
    if (kind === 'app') {
      const r = await fetch('https://api.github.com/installation/repositories?per_page=100', { headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json', 'User-Agent': 'miu' } });
      if (r.ok) reach = (await r.json()).repositories.map((x) => x.full_name);
    }
  } catch { /* no App yet */ }
  const names = [...new Set([...prof.keys(), ...(reach ?? [])])].sort();
  return { reach, rows: names.map((repo) => ({ repo, profile: prof.get(repo) ?? null, on: on.has(repo), reachable: reach ? reach.includes(repo) : null })) };
}

// A repo Miu has no profile for: Miu reads it and writes a first profile
// (lib/newprofile.mjs), so nobody writes JSON to start.
const addRepoForm = `<form id="add" style="margin-top:14px"><b>Add a repository</b><input name="repo" placeholder="owner/name" autocomplete="off" style="box-sizing:border-box;width:100%;height:34px;margin:6px 0 10px;padding:0 10px;background:#171717;border:1px solid #353535;border-radius:8px;color:#ececec"><button class="btn">Make a profile</button> <span id="addmsg"></span></form>`;
const addRepoScript = `const addRepo = async (repo, msg) => { msg.textContent = 'Reading ' + repo + '...'; const r = await send('/api/profiles', { repo }); msg.textContent = r.error || 'Added. Miu tests its pull requests from now on.'; if (!r.error) setTimeout(() => location.reload(), 900); };
document.querySelectorAll('[data-add]').forEach((b) => b.addEventListener('click', () => { b.disabled = true; addRepo(b.dataset.add, b); }));
const af = document.getElementById('add');
if (af) af.addEventListener('submit', (e) => { e.preventDefault(); addRepo(af.repo.value.trim(), document.getElementById('addmsg')); });`;

// One repo's profile as JSON, for an admin to change (docs/profiles.md says what each field does).
function profilePage(url, res) {
  const repo = url.searchParams.get('repo') ?? '';
  const text = gh.validRepo(repo) ? profileText(repo) : null;
  res.writeHead(text == null ? 404 : 200, { 'Content-Type': 'text/html; charset=utf-8' });
  if (text == null) return res.end(page('No such profile', '<h1>No profile for that repo</h1>'));
  res.end(page(`Profile: ${repo}`, `<h1>How Miu tests ${escHtml(repo)}</h1>
<p>The test profile, as JSON. <a href="https://github.com/akashmdiu/miu/blob/main/docs/profiles.md" target="_blank" rel="noopener">What each field does</a>. A change applies from the next run.</p>
<form id="pf"><textarea name="text" spellcheck="false" style="box-sizing:border-box;width:100%;height:60vh;padding:12px;background:#171717;border:1px solid #353535;border-radius:8px;color:#ececec;font:13px/1.5 ui-monospace,Menlo,monospace">${escHtml(text)}</textarea>
<p><button class="btn">Save</button> <span id="pfmsg"></span></p></form>
<p><a href="/github-app">Back to GitHub and repositories</a></p>
<script>
const f = document.getElementById('pf');
f.addEventListener('submit', async (e) => { e.preventDefault(); const m = document.getElementById('pfmsg'); m.textContent = 'Saving...';
  const r = await fetch('/api/profiles/save', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-QA-Dashboard': '1' }, body: JSON.stringify({ repo: ${JSON.stringify(repo).replace(/</g, '\\u003c')}, text: f.text.value }) }).then((x) => x.json());
  m.textContent = r.error || 'Saved. The next run uses it.'; });
</script>`));
}

async function githubAppPage(res) {
  const st = await appStatus();
  let body;
  if (st.state === 'none') {
    const state = crypto.randomBytes(16).toString('hex');
    appStates.add(state);
    const m = JSON.stringify(manifest(`${authCfg().publicUrl}/github-app/callback`)).replace(/"/g, '&quot;');
    body = `<h1>Give Miu its own GitHub account</h1>
<p>Without an App, Miu posts comments, labels and statuses with the gh login on this machine, so they show under that person's name. A GitHub App makes them show as <b>Miu [bot]</b>.</p>
<div class="box"><p>The App may write comments, labels and commit statuses, and read code. It cannot push, merge or approve.</p>
<form action="https://github.com/settings/apps/new?state=${state}" method="post"><input type="hidden" name="manifest" value="${m}"><button class="btn">Create the App on GitHub</button></form></div>
<p>GitHub asks you to confirm the name. App names are unique on GitHub; if the one offered is taken, add a word to it.</p>`;
  } else {
    const steps = [
      `<li>Add the logo: open <a href="${st.settingsUrl}" target="_blank" rel="noopener">the App's settings</a>, and under Display information upload <code>assets/brand/miu-avatar-512.png</code>.</li>`,
      st.state === 'ready' ? `<li class="ok">Installed on ${escHtml(appOwner())} for ${st.repos.join(', ')}. Miu now posts as ${st.slug} [bot].</li>`
        : st.state === 'partial' ? `<li class="bad">Installed, but not on ${st.missing.join(', ')}. <a href="${st.installUrl}" target="_blank" rel="noopener">Add those repos</a>.</li>`
        : st.state === 'error' ? `<li class="bad">Could not check the App: ${escHtml(st.error)}</li>`
        : `<li><a href="${st.installUrl}" target="_blank" rel="noopener">Install it on ${escHtml(appOwner() ?? 'your account')}</a> for ${escHtml(profiles().map((p) => p.repo.split('/')[1]).join(', ') || 'the repos Miu tests')}. On an organization, a member sends a request and an owner approves it. Until then Miu keeps posting with your gh login.</li>`,
    ];
    const cfg = authCfg();
    const { reach, rows } = await repoRows();
    const repoHtml = rows.map((r) => `<li class="repo"><span><b>${escHtml(r.repo)}</b><small>${r.profile ? escHtml(r.profile.kind === 'hub' ? 'App' : 'WordPress plugin') + ' profile' : 'no test profile yet'}${r.reachable === false ? ' · the App cannot reach it' : ''}</small></span>${r.profile ? `<a class="tbtn" style="line-height:28px;text-decoration:none" href="/github-app/profile?repo=${encodeURIComponent(r.repo)}">Edit</a> <button class="tbtn${r.on ? ' on' : ''}" data-repo="${escHtml(r.repo)}" data-on="${r.on ? '0' : '1'}">${r.on ? 'Tested' : 'Not tested'}</button>` : `<button class="tbtn" data-add="${escHtml(r.repo)}">Make a profile</button>`}</li>`).join('');
    const signIn = cfg.ready
      ? `<p class="ok">GitHub sign-in is set up${cfg.required ? ' and required' : '; it is off while the dashboard listens only on this machine'}.</p>`
      : `<p>Sign-in needs the App's client secret. In <a href="${st.settingsUrl}" target="_blank" rel="noopener">the App's settings</a>: add the callback URL <code>${escHtml(cfg.publicUrl)}/auth/callback</code>, press <b>Generate a new client secret</b>, and paste it here. It is stored in <code>~/.config/miu/github-app.json</code> (only you can read it) and never shown again.</p>
         <form id="sec"><input name="secret" type="password" autocomplete="off" placeholder="Client secret" style="box-sizing:border-box;width:100%;height:34px;margin:6px 0 10px;padding:0 10px;background:#171717;border:1px solid #353535;border-radius:8px;color:#ececec"><button class="btn">Save</button> <span id="secmsg"></span></form>`;
    body = `<h1>Miu on GitHub: ${escHtml(st.slug)}</h1><p>Owned by ${escHtml(st.owner)}. Its key is in <code>~/.config/miu/github-app.json</code>, outside the repo.</p>
<h2>The App</h2><div class="box"><ol>${steps.join('')}</ol></div>
<h2>Repositories</h2><div class="box"><p>${reach ? 'The repos the App can reach, and the ones Miu has a test profile for.' : 'The repos Miu has a test profile for. Once the App is installed, the repos it can reach show here too.'} <a href="${st.installUrl}" target="_blank" rel="noopener">Connect repositories</a></p><ul class="repos">${repoHtml}</ul>${addRepoForm}</div>
<h2>Sign-in</h2><div class="box">${signIn}</div>
<p><a href="/github-app">Check again</a></p>
<script>
const send = (url, data) => fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-QA-Dashboard': '1' }, body: JSON.stringify(data) }).then((r) => r.json());
document.querySelectorAll('[data-repo]').forEach((b) => b.addEventListener('click', async () => { b.disabled = true; await send('/api/config', { repo: b.dataset.repo, on: b.dataset.on === '1' }); location.reload(); }));
${addRepoScript}
const f = document.getElementById('sec');
if (f) f.addEventListener('submit', async (e) => { e.preventDefault(); const r = await send('/api/app-secret', { secret: f.secret.value }); document.getElementById('secmsg').textContent = r.error || 'Saved.'; if (!r.error) setTimeout(() => location.reload(), 600); });
</script>`;
  }
  res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
  res.end(page('Miu on GitHub', body));
}

async function githubAppCallback(url, res) {
  const state = url.searchParams.get('state');
  const code = url.searchParams.get('code');
  let body;
  if (!state || !appStates.has(state) || !code) body = '<h1 class="bad">That link did not come from this page</h1><p>Start again from <a href="/github-app">Miu on GitHub</a>.</p>';
  else {
    appStates.delete(state);
    try { const a = await convertManifest(code); res.writeHead(302, { Location: '/github-app' }); console.log(`github app ${a.slug} created`); return res.end(); }
    catch (e) { body = `<h1 class="bad">The App was not saved</h1><p>${String(e.message).replace(/</g, '&lt;')}</p>`; }
  }
  res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
  res.end(page('Miu on GitHub', body));
}

// ---- sign-in and request safety
const authCfg = () => auth.authConfig({ port: PORT, host: HOST });
const sessions = auth.sessionStore(RUNS);
const escHtml = (t) => String(t ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
// A request from this machine without a proxy in between (set-up only).
const isLocal = (req) => ['127.0.0.1', '::1', '::ffff:127.0.0.1'].includes(req.socket.remoteAddress) && !req.headers['x-forwarded-for'];
const PUBLIC_PATHS = /^\/(auth\/(login|github|callback|setup|invite\/[\w-]+)|brand\/[\w.-]+)$/;
function securityHeaders(res) {
  res.setHeader('X-Content-Type-Options', 'nosniff');
  res.setHeader('X-Frame-Options', 'DENY');
  res.setHeader('Referrer-Policy', 'same-origin');
  res.setHeader('Permissions-Policy', 'camera=(), microphone=(), geolocation=()');
  res.setHeader('Cross-Origin-Opener-Policy', 'same-origin');
  if (authCfg().secure) res.setHeader('Strict-Transport-Security', 'max-age=31536000');
}
